<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>HerdMe.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
    <DefaultLanguage>en-US</DefaultLanguage>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <HerdMeVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../VERSION'))</HerdMeVersionFile>
    <HerdMeBuildNumberFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../BUILD_NUMBER'))</HerdMeBuildNumberFile>
    <HerdMeVersion>$([System.IO.File]::ReadAllText('$(HerdMeVersionFile)').Trim())</HerdMeVersion>
    <HerdMeBuildNumber>$([System.IO.File]::ReadAllText('$(HerdMeBuildNumberFile)').Trim())</HerdMeBuildNumber>
    <Version>$(HerdMeVersion)</Version>
    <AssemblyVersion>$(HerdMeVersion).$(HerdMeBuildNumber)</AssemblyVersion>
    <FileVersion>$(HerdMeVersion).$(HerdMeBuildNumber)</FileVersion>
    <ApplicationIcon>Assets\HerdMe.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Runtime\herdme-core.exe" Condition="Exists('Runtime\herdme-core.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Runtime\herdme-core.exe</TargetPath>
    </Content>
    <Content Include="..\..\LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>LICENSE</TargetPath>
    </Content>
    <Content Include="..\..\docs\THIRD_PARTY.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>THIRD_PARTY.md</TargetPath>
    </Content>
    <Content Include="..\..\HerdMe\Resources\release-manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>release-manifest.json</TargetPath>
    </Content>
    <Content Include="..\..\HerdMe\Resources\release-public-key.txt" Condition="Exists('..\..\HerdMe\Resources\release-public-key.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>release-public-key.txt</TargetPath>
    </Content>
    <Content Include="..\..\HerdMe\Resources\release-feed-url.txt" Condition="Exists('..\..\HerdMe\Resources\release-feed-url.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>release-feed-url.txt</TargetPath>
    </Content>
    <EmbeddedResource Include="..\..\HerdMe\Resources\runtime-catalog.json" LogicalName="HerdMe.runtime-catalog.json" />
  </ItemGroup>
</Project>
