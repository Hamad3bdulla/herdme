<Page
    x:Class="HerdMe.Windows.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="UpdatesPageRoot"
    AutomationProperties.AutomationId="UpdatesPageRoot"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1">
            <StackPanel Style="{StaticResource PageContentStyle}">
                <Grid Style="{StaticResource PageHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="UpdatesTitle" Text="Updates" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Name="LastCheckedText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="RefreshButton" Grid.Column="1" VerticalAlignment="Center" Click="Refresh_Click">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Refresh" />
                            <TextBlock x:Uid="UpdatesRefreshButtonText" Text="Check" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar
                    x:Name="StatusBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational" />

                <!-- Summary: how many, how big, how long, and one button for all of them. -->
                <Border x:Name="SummaryCard" Style="{StaticResource CardStyle}" AutomationProperties.AutomationId="UpdatesSummary">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="SummaryGlyph" Glyph="&#xE896;" FontSize="28" VerticalAlignment="Center" Style="{StaticResource StatusGlyphNeutralStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SummaryTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SummaryDetail" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="SummaryWarning" Style="{StaticResource StatusCriticalTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                        <Button
                            x:Name="UpdateAllButton"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="UpdatesUpdateAll"
                            Click="UpdateAll_Click"
                            VerticalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Download" />
                                <TextBlock x:Name="UpdateAllText" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Text="HerdMe" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/HerdMe.png" Width="32" Height="32" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="ApplicationStatusText" FontWeight="SemiBold" Style="{StaticResource SettingsRowTitleStyle}" />
                                <StackPanel x:Name="ApplicationBadges" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ApplicationVersionText" Style="{StaticResource SettingsRowDescriptionStyle}" />
                            <TextBlock x:Name="ApplicationStageText" Style="{StaticResource SettingsRowDescriptionStyle}" Visibility="Collapsed" />
                            <ProgressBar x:Name="ApplicationProgress" Margin="0,6,0,0" MaxWidth="360" HorizontalAlignment="Left" Width="360" Visibility="Collapsed" />
                            <TextBlock x:Name="ApplicationErrorText" Style="{StaticResource StatusCriticalTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                x:Name="DownloadApplicationButton"
                                AutomationProperties.AutomationId="UpdatesApplicationDownload"
                                Click="DownloadApplication_Click"
                                Visibility="Collapsed"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Download" />
                                    <TextBlock x:Name="DownloadApplicationText" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="RestartApplicationButton"
                                AutomationProperties.AutomationId="UpdatesApplicationRestart"
                                Click="RestartApplication_Click"
                                Visibility="Collapsed"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE777;" FontSize="16" />
                                    <TextBlock x:Uid="UpdatesRestartToUpdate" Text="Restart to update" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="CancelApplicationButton"
                                Click="CancelApplication_Click"
                                Visibility="Collapsed"
                                Style="{StaticResource ToolbarIconButtonStyle}">
                                <SymbolIcon Symbol="Cancel" />
                            </Button>
                            <Button
                                x:Name="ApplicationMoreButton"
                                Visibility="Collapsed"
                                Style="{StaticResource ToolbarIconButtonStyle}">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="AvailableHeader" x:Uid="UpdatesAvailableHeader" Text="Available updates" Style="{StaticResource SectionHeaderStyle}" />
                <ProgressBar x:Name="ComponentCheckProgress" IsIndeterminate="True" Visibility="Collapsed" />
                <StackPanel x:Name="ComponentRows" Spacing="12" />
                <Border x:Name="EmptyState" Style="{StaticResource SettingsGroupStyle}">
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE930;" Style="{StaticResource StatusGlyphSuccessStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Uid="UpdatesNoComponents" Grid.Column="1" Text="All installed components are up to date." VerticalAlignment="Center" Style="{StaticResource SettingsRowTitleStyle}" />
                    </Grid>
                </Border>

                <!-- Everything installed that has nothing new, with pinning and rollback. -->
                <Expander
                    x:Name="UpToDateExpander"
                    AutomationProperties.AutomationId="UpdatesUpToDate"
                    Margin="0,12,0,0"
                    IsExpanded="False"
                    Style="{StaticResource GeneralSectionExpanderStyle}">
                    <Expander.Header>
                        <TextBlock x:Name="UpToDateHeader" Style="{StaticResource GeneralSectionHeaderTextStyle}" />
                    </Expander.Header>
                    <Border Style="{StaticResource SettingsGroupInExpanderStyle}">
                        <StackPanel x:Name="UpToDateRows" />
                    </Border>
                </Expander>

                <Grid Margin="0,12,0,0">
                    <TextBlock x:Uid="UpdatesHistoryTitle" Text="History" VerticalAlignment="Center" Style="{StaticResource SectionHeaderStyle}" Margin="2,6,2,0" />
                    <Button
                        x:Name="ClearHistoryButton"
                        x:Uid="UpdatesHistoryClearButton"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Clear update history"
                        Click="ClearHistory_Click"
                        Style="{StaticResource ToolbarIconButtonStyle}">
                        <ToolTipService.ToolTip><ToolTip><TextBlock x:Uid="UpdatesHistoryClear" Text="Clear update history" /></ToolTip></ToolTipService.ToolTip>
                        <SymbolIcon Symbol="Clear" />
                    </Button>
                </Grid>
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel>
                        <StackPanel x:Name="HistoryRows" />
                        <TextBlock x:Name="HistoryEmptyText" x:Uid="UpdatesHistoryEmpty" Text="Nothing has been updated yet." Margin="16,14" Style="{StaticResource SecondaryTextStyle}" />
                        <HyperlinkButton x:Name="HistoryMoreButton" Margin="10,0,10,8" Click="HistoryMore_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <TextBlock x:Uid="UpdatesAutomaticTitle" Text="Automatic updates" Style="{StaticResource SectionHeaderStyle}" Margin="2,12,2,0" />
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE823;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                            <TextBlock x:Uid="UpdatesAutoInstallTitle" Text="Install component updates by themselves" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock x:Uid="UpdatesAutoInstallDescription" Text="PHP, Node.js, services and tools only. New major versions and HerdMe itself always wait for you." Style="{StaticResource SettingsRowDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="AutoInstallCombo"
                            x:Uid="UpdatesAutoInstallCombo"
                            Grid.Column="2"
                            MinWidth="200"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Install component updates by themselves"
                            SelectionChanged="AutoInstall_SelectionChanged">
                            <ComboBoxItem x:Uid="UpdatesAutoInstallOff" Content="Never" Tag="Off" />
                            <ComboBoxItem x:Uid="UpdatesAutoInstallIdle" Content="When the PC is idle" Tag="Idle" />
                            <ComboBoxItem x:Uid="UpdatesAutoInstallOnExit" Content="When HerdMe quits" Tag="OnExit" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Padding="28,12,28,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing Width="18" Height="18" IsActive="True" />
                <TextBlock x:Name="BusyText" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
