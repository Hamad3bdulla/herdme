<Page
    x:Class="HerdMe.Windows.Pages.DebuggerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="DebuggerPageRoot"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock x:Uid="DebuggerPageTitle" AutomationProperties.AutomationId="DebuggerPageRoot" Text="Debugger" Style="{StaticResource TitleTextBlockStyle}" />

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="DebuggerXdebugTitle" Text="Xdebug" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ExtensionPathText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing x:Name="InstallProgress" Width="16" Height="16" />
                        <TextBlock x:Name="InstallStatusText" x:Uid="DebuggerCheckingInitial" Text="Checking" VerticalAlignment="Center" />
                        <Button x:Name="InstallButton" Click="Install_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Download" />
                                <TextBlock x:Name="InstallButtonText" x:Uid="DebuggerInstallButton" Text="Install" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="DebuggerSessionSettingsTitle" Text="Session settings" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="DebuggerEnableLabel" Text="Enable Xdebug" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="EnabledToggle" Grid.Column="1" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="DebuggerRequireTriggerLabel" Text="Require debug trigger" VerticalAlignment="Center" />
                        <ToggleSwitch
                            x:Name="TriggerToggle"
                            Grid.Column="1">
                            <ToolTipService.ToolTip>
                                <ToolTip><TextBlock x:Uid="DebuggerTriggerTooltip" Text="Start Xdebug only for requests that include XDEBUG_TRIGGER" /></ToolTip>
                            </ToolTipService.ToolTip>
                        </ToggleSwitch>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="DebuggerPortLabel" Text="Debug port" VerticalAlignment="Center" />
                        <NumberBox x:Name="PortBox" Grid.Column="1" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="DebuggerIdeKeyLabel" Text="IDE key" VerticalAlignment="Center" />
                        <TextBox x:Name="IdeKeyBox" Grid.Column="1" MaxLength="80" />
                    </Grid>
                    <TextBlock x:Name="EndpointText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button HorizontalAlignment="Left" Click="Save_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Save" />
                            <TextBlock x:Uid="DebuggerSaveButton" Text="Save" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="SaveStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="DebuggerSessionTitle" Text="Debug session" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="DebuggerSiteLabel" Text="Site" VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="SiteBox"
                            Grid.Column="1"
                            ItemsSource="{x:Bind Sites}"
                            DisplayMemberPath="Domain"
                            SelectionChanged="SiteBox_SelectionChanged" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing x:Name="SessionProgress" Width="16" Height="16" />
                        <TextBlock x:Name="SessionStatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="StartSessionButton" Click="StartSession_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Play" />
                                <TextBlock x:Uid="DebuggerStartSessionButton" Text="Start Session" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
