<Page
    x:Class="HerdMe.Windows.Pages.DebuggerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Debugger" Style="{StaticResource TitleTextBlockStyle}" />

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Xdebug" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ExtensionPathText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing x:Name="InstallProgress" Width="16" Height="16" />
                        <TextBlock x:Name="InstallStatusText" Text="Checking" VerticalAlignment="Center" />
                        <Button x:Name="InstallButton" Click="Install_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Download" />
                                <TextBlock Text="Install" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Session settings" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Enable Xdebug" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="EnabledToggle" Grid.Column="1" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start on trigger" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="TriggerToggle" Grid.Column="1" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Debug port" VerticalAlignment="Center" />
                        <NumberBox x:Name="PortBox" Grid.Column="1" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="IDE key" VerticalAlignment="Center" />
                        <TextBox x:Name="IdeKeyBox" Grid.Column="1" MaxLength="80" />
                    </Grid>
                    <TextBlock x:Name="EndpointText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button HorizontalAlignment="Left" Click="Save_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Save" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="SaveStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Debug session" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Site" VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="SiteBox"
                            Grid.Column="1"
                            ItemsSource="{x:Bind Sites}"
                            DisplayMemberPath="Domain"
                            SelectionChanged="SiteBox_SelectionChanged" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing x:Name="SessionProgress" Width="16" Height="16" />
                        <TextBlock x:Name="SessionStatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="StartSessionButton" Click="StartSession_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Play" />
                                <TextBlock Text="Start Session" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
