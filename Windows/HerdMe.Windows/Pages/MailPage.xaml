<Page
    x:Class="HerdMe.Windows.Pages.MailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HerdMe.Windows.Models"
    AutomationProperties.AutomationId="MailPageRoot"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Uid="MailPageTitle" AutomationProperties.AutomationId="MailPageRoot" Text="Mail" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="MailPageSubtitle" Text="Catch outgoing email from your local sites and preview it here." Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="CopyMailSettingsButton" Click="CopyMailSettings_Click" AutomationProperties.AutomationId="CopyMailSettingsButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Copy" />
                        <TextBlock x:Uid="MailCopySettingsButton" Text="Copy mail settings" />
                    </StackPanel>
                </Button>
                <Button VerticalAlignment="Center" Click="AddToEnvironment_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Edit" />
                        <TextBlock x:Uid="MailEnvironmentButton" Text="Add to .env..." />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SettingsGroupStyle}">
            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTileStyle}" Background="{ThemeResource MailTintBrush}" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE715;" FontSize="18" Foreground="{ThemeResource MailInkBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                    <TextBlock x:Uid="MailCaptureTitle" Text="SMTP capture" FontWeight="SemiBold" Style="{StaticResource SettingsRowTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="ServerStatusDot" Style="{StaticResource StatusDotNeutralStyle}" />
                        <TextBlock x:Name="ServerStatusText" x:Uid="MailStoppedInitial" Text="Stopped" Style="{StaticResource SettingsRowDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ServerButton" x:Uid="MailServerButton" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="Start or stop SMTP capture" Click="Server_Click" Style="{StaticResource ToolbarIconButtonStyle}">
                    <ToolTipService.ToolTip>
                        <ToolTip><TextBlock x:Uid="MailServerTooltip" Text="Start or stop SMTP capture" /></ToolTip>
                    </ToolTipService.ToolTip>
                    <SymbolIcon x:Name="ServerButtonIcon" Symbol="Play" />
                </Button>
            </Grid>
        </Border>

        <InfoBar x:Name="CaptureErrorBar" Grid.Row="2" IsOpen="False" Severity="Error">
            <InfoBar.ActionButton>
                <Button x:Uid="MailCaptureRetryButton" Content="Reload" Click="RetryLoad_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220" MaxWidth="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource ToolPaneStyle}" Padding="12,8,8,8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="MailInboxTitle" Text="Inbox" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <ProgressRing x:Name="CaptureProgress" x:Uid="MailCaptureProgress" Width="18" Height="18" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Loading captured data" />
                            <Button x:Uid="MailCaptureRefreshButton" Click="RetryLoad_Click" Style="{StaticResource ToolbarIconButtonStyle}" AutomationProperties.Name="Refresh captured data">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F5" />
                                </Button.KeyboardAccelerators>
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="MailCaptureRefreshTooltip" Text="Refresh" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <SymbolIcon Symbol="Refresh" />
                            </Button>
                            <Button x:Name="ClearButton" x:Uid="MailClearButton" Click="Clear_Click" AutomationProperties.Name="Delete all messages" Style="{StaticResource DangerToolbarIconButtonStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="MailClearTooltip" Text="Delete all messages" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBox
                        x:Name="SearchBox"
                        x:Uid="MailSearchField"
                        Grid.Row="1"
                        Margin="0,0,4,0"
                        PlaceholderText="Search messages"
                        TextChanged="SearchBox_TextChanged"
                        AutomationProperties.Name="Search messages">
                        <TextBox.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="SearchAccelerator_Invoked" />
                        </TextBox.KeyboardAccelerators>
                    </TextBox>
                    <ListView
                        x:Name="MessageList"
                        Grid.Row="2"
                        ItemsSource="{x:Bind Messages}"
                        SelectionChanged="MessageList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CapturedMail">
                                <StackPanel Padding="0,4" Spacing="2">
                                    <TextBlock Text="{x:Bind SenderPreview}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SubjectPreview}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ReceivedText}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="EmptyStatePanel" Grid.Row="2" Margin="16" MaxWidth="340" Spacing="10" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="EmptyState" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                        <!-- First run: show exactly what to put in a Laravel .env and offer to write it. -->
                        <StackPanel x:Name="SmtpSetupPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Uid="MailSmtpSetupHint" Text="Send your app's email here by using these settings in its .env file:" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                            <Border Padding="12,8" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <TextBlock x:Name="SmtpSnippetText" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" FlowDirection="LeftToRight" TextWrapping="Wrap" />
                            </Border>
                            <Button HorizontalAlignment="Center" Click="AddToEnvironment_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Edit" />
                                    <TextBlock x:Uid="MailSmtpSetupButton" Text="Add to a site's .env..." />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource ToolPaneStyle}" Padding="16,10,8,8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SubjectText" x:Uid="MailSelectMessageInitial" Text="Select a message" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <ToggleButton x:Name="MobileWidthToggle" x:Uid="MailMobileWidthToggle" IsEnabled="False" Click="MobileWidth_Click" Style="{StaticResource ToolbarIconToggleButtonStyle}" AutomationProperties.Name="Preview at phone width" AutomationProperties.AutomationId="MailMobileWidthToggle">
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="MailMobileWidthTooltip" Text="Preview at phone width (375 px)" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <FontIcon Glyph="&#xE8EA;" FontSize="16" />
                            </ToggleButton>
                            <Button x:Name="ExportButton" x:Uid="MailExportButton" Click="Export_Click" IsEnabled="False" Style="{StaticResource ToolbarIconButtonStyle}" AutomationProperties.Name="Export full message">
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="MailExportTooltip" Text="Export full message" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <SymbolIcon Symbol="Save" />
                            </Button>
                            <Button x:Name="DeleteButton" x:Uid="MailDeleteButton" Click="Delete_Click" IsEnabled="False" AutomationProperties.Name="Delete message" Style="{StaticResource DangerToolbarIconButtonStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="MailDeleteTooltip" Text="Delete message" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SenderText" Grid.Row="1" Style="{StaticResource SettingsRowDescriptionStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="RecipientText" Grid.Row="2" Style="{StaticResource SettingsRowDescriptionStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                    <InfoBar x:Name="PreviewSizeNotice" x:Uid="MailPreviewSizeNotice" Grid.Row="3" IsOpen="False" IsClosable="False" Severity="Informational" Message="This view is shortened. Export the message to save its full contents." />
                    <TabView x:Name="MailViewTabs" Grid.Row="4" Margin="-8,4,0,0" IsAddTabButtonVisible="False">
                        <TabViewItem x:Uid="MailPreviewTab" Header="Preview" IsClosable="False">
                            <Grid x:Name="PreviewHost">
                                <WebView2
                                    x:Name="HtmlPreview"
                                    Visibility="Collapsed"
                                    NavigationCompleted="HtmlPreview_NavigationCompleted" />
                                <ProgressRing x:Name="MailPreviewProgress" x:Uid="MailPreviewProgress" Width="32" Height="32" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Preparing message preview" />
                                <StackPanel
                                    x:Name="MailPreviewFailureState"
                                    Visibility="Collapsed"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Important" />
                                    <TextBlock x:Uid="MailPreviewUnavailable" Text="Preview unavailable" FontWeight="SemiBold" />
                                    <Button
                                        x:Uid="MailRetryPreviewButton"
                                        HorizontalAlignment="Center"
                                        Click="RetryMailPreview_Click"
                                        AutomationProperties.Name="Retry message preview">
                                        <ToolTipService.ToolTip>
                                            <ToolTip><TextBlock x:Uid="MailRetryPreviewTooltip" Text="Retry preview" /></ToolTip>
                                        </ToolTipService.ToolTip>
                                        <SymbolIcon Symbol="Refresh" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </TabViewItem>
                        <TabViewItem x:Uid="MailTextTab" Header="Text" IsClosable="False">
                            <ScrollViewer>
                                <TextBlock x:Name="BodyText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem x:Uid="MailHeadersTab" Header="Headers" IsClosable="False">
                            <ScrollViewer>
                                <StackPanel x:Name="HeaderList" Spacing="6" Padding="0,8,8,8" AutomationProperties.AutomationId="MailHeaderList" />
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem x:Name="LinksTab" x:Uid="MailLinksTab" Header="Links" IsClosable="False">
                            <ScrollViewer>
                                <StackPanel Spacing="8" Padding="0,8,8,8">
                                    <TextBlock x:Name="LinkSummaryText" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                    <StackPanel x:Name="LinkList" Spacing="6" AutomationProperties.AutomationId="MailLinkList" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem x:Uid="MailRawTab" Header="Raw" IsClosable="False">
                            <ScrollViewer>
                                <TextBlock x:Name="RawText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" FlowDirection="LeftToRight" />
                            </ScrollViewer>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
