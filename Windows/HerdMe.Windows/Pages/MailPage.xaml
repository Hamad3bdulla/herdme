<Page
    x:Class="HerdMe.Windows.Pages.MailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HerdMe.Windows.Models"
    AutomationProperties.AutomationId="MailPageRoot"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="MailPageTitle" AutomationProperties.AutomationId="MailPageRoot" Text="Mail" Style="{StaticResource PageTitleStyle}" />
            <Button Grid.Column="1" Click="AddToEnvironment_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Edit" />
                    <TextBlock x:Uid="MailEnvironmentButton" Text="Add to .env..." />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SectionDividerStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Uid="MailCaptureTitle" Text="SMTP capture" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="ServerStatusText" x:Uid="MailStoppedInitial" Text="Stopped" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="ServerButton" Grid.Column="1" Click="Server_Click">
                    <ToolTipService.ToolTip>
                        <ToolTip><TextBlock x:Uid="MailServerTooltip" Text="Start or stop SMTP capture" /></ToolTip>
                    </ToolTipService.ToolTip>
                    <SymbolIcon x:Name="ServerButtonIcon" Symbol="Play" />
                </Button>
            </Grid>
        </Border>

        <InfoBar x:Name="CaptureErrorBar" Grid.Row="2" IsOpen="False" Severity="Error">
            <InfoBar.ActionButton>
                <Button x:Uid="MailCaptureRetryButton" Content="Reload" Click="RetryLoad_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220" MaxWidth="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource ToolPaneStyle}" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="MailInboxTitle" Text="Inbox" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <ProgressRing x:Name="CaptureProgress" x:Uid="MailCaptureProgress" Width="18" Height="18" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Loading captured data" />
                            <Button x:Uid="MailCaptureRefreshButton" Click="RetryLoad_Click" Style="{StaticResource ToolbarIconButtonStyle}" AutomationProperties.Name="Refresh captured data">
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="MailCaptureRefreshTooltip" Text="Refresh" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <SymbolIcon Symbol="Refresh" />
                            </Button>
                            <Button x:Name="ClearButton" Click="Clear_Click" Style="{StaticResource ToolbarIconButtonStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="MailClearTooltip" Text="Delete all messages" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBox
                        x:Name="SearchBox"
                        x:Uid="MailSearchField"
                        Grid.Row="1"
                        PlaceholderText="Search messages"
                        TextChanged="SearchBox_TextChanged"
                        AutomationProperties.Name="Search messages" />
                    <ListView
                        x:Name="MessageList"
                        Grid.Row="2"
                        ItemsSource="{x:Bind Messages}"
                        SelectionChanged="MessageList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CapturedMail">
                                <StackPanel Padding="6" Spacing="3">
                                    <TextBlock Text="{x:Bind SenderPreview}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SubjectPreview}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ReceivedText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Padding="4,12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SubjectText" x:Uid="MailSelectMessageInitial" Text="Select a message" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="ExportButton" x:Uid="MailExportButton" Click="Export_Click" IsEnabled="False" Style="{StaticResource ToolbarIconButtonStyle}" AutomationProperties.Name="Export full message">
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="MailExportTooltip" Text="Export full message" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <SymbolIcon Symbol="Save" />
                            </Button>
                            <Button x:Name="DeleteButton" Click="Delete_Click" IsEnabled="False" Style="{StaticResource ToolbarIconButtonStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="MailDeleteTooltip" Text="Delete message" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SenderText" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="RecipientText" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <InfoBar x:Name="PreviewSizeNotice" x:Uid="MailPreviewSizeNotice" Grid.Row="3" IsOpen="False" IsClosable="False" Severity="Informational" Message="This view is shortened. Export the message to save its full contents." />
                    <TabView Grid.Row="4" Margin="0,8,0,0" IsAddTabButtonVisible="False">
                        <TabViewItem x:Uid="MailPreviewTab" Header="Preview" IsClosable="False">
                            <Grid>
                                <WebView2
                                    x:Name="HtmlPreview"
                                    Visibility="Collapsed"
                                    NavigationCompleted="HtmlPreview_NavigationCompleted" />
                                <ProgressRing x:Name="MailPreviewProgress" x:Uid="MailPreviewProgress" Width="32" Height="32" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Preparing message preview" />
                                <StackPanel
                                    x:Name="MailPreviewFailureState"
                                    Visibility="Collapsed"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Important" />
                                    <TextBlock x:Uid="MailPreviewUnavailable" Text="Preview unavailable" FontWeight="SemiBold" />
                                    <Button
                                        x:Uid="MailRetryPreviewButton"
                                        HorizontalAlignment="Center"
                                        Click="RetryMailPreview_Click"
                                        AutomationProperties.Name="Retry message preview">
                                        <ToolTipService.ToolTip>
                                            <ToolTip><TextBlock x:Uid="MailRetryPreviewTooltip" Text="Retry preview" /></ToolTip>
                                        </ToolTipService.ToolTip>
                                        <SymbolIcon Symbol="Refresh" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </TabViewItem>
                        <TabViewItem x:Uid="MailTextTab" Header="Text" IsClosable="False">
                            <ScrollViewer>
                                <TextBlock x:Name="BodyText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem x:Uid="MailRawTab" Header="Raw" IsClosable="False">
                            <ScrollViewer>
                                <TextBlock x:Name="RawText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
