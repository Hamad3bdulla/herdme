<Page
    x:Class="HerdMe.Windows.Pages.MailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HerdMe.Windows.Models"
    AutomationProperties.AutomationId="MailPageRoot"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock x:Uid="MailPageTitle" Text="Mail" Style="{StaticResource TitleTextBlockStyle}" />
            <Button HorizontalAlignment="Right" Click="CopyEnvironment_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Copy" />
                    <TextBlock x:Uid="MailCopyEnvironmentButton" Text="Copy .env" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Uid="MailCaptureTitle" Text="SMTP capture" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ServerStatusText" x:Uid="MailStoppedInitial" Text="Stopped" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="ServerButton" Grid.Column="1" Click="Server_Click">
                    <ToolTipService.ToolTip>
                        <ToolTip><TextBlock x:Uid="MailServerTooltip" Text="Start or stop SMTP capture" /></ToolTip>
                    </ToolTipService.ToolTip>
                    <SymbolIcon x:Name="ServerButtonIcon" Symbol="Play" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Uid="MailInboxTitle" Text="Inbox" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button HorizontalAlignment="Right" Click="Clear_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip><TextBlock x:Uid="MailClearTooltip" Text="Delete all messages" /></ToolTip>
                            </ToolTipService.ToolTip>
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </Grid>
                    <TextBox
                        x:Name="SearchBox"
                        x:Uid="MailSearchField"
                        Grid.Row="1"
                        PlaceholderText="Search messages"
                        TextChanged="SearchBox_TextChanged"
                        AutomationProperties.Name="Search messages" />
                    <ListView
                        x:Name="MessageList"
                        Grid.Row="2"
                        ItemsSource="{x:Bind Messages}"
                        SelectionChanged="MessageList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CapturedMail">
                                <StackPanel Padding="6" Spacing="3">
                                    <TextBlock Text="{x:Bind Sender}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subject}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ReceivedText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="SubjectText" x:Uid="MailSelectMessageInitial" Text="Select a message" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <Button x:Name="DeleteButton" HorizontalAlignment="Right" Click="Delete_Click" IsEnabled="False">
                            <ToolTipService.ToolTip>
                                <ToolTip><TextBlock x:Uid="MailDeleteTooltip" Text="Delete message" /></ToolTip>
                            </ToolTipService.ToolTip>
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="SenderText" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="RecipientText" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TabView Grid.Row="3" Margin="0,8,0,0" IsAddTabButtonVisible="False">
                        <TabViewItem x:Uid="MailPreviewTab" Header="Preview" IsClosable="False">
                            <Grid>
                                <WebView2
                                    x:Name="HtmlPreview"
                                    NavigationCompleted="HtmlPreview_NavigationCompleted" />
                                <StackPanel
                                    x:Name="MailPreviewFailureState"
                                    Visibility="Collapsed"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Important" />
                                    <TextBlock x:Uid="MailPreviewUnavailable" Text="Preview unavailable" FontWeight="SemiBold" />
                                    <Button
                                        x:Uid="MailRetryPreviewButton"
                                        HorizontalAlignment="Center"
                                        Click="RetryMailPreview_Click"
                                        AutomationProperties.Name="Retry message preview">
                                        <ToolTipService.ToolTip>
                                            <ToolTip><TextBlock x:Uid="MailRetryPreviewTooltip" Text="Retry preview" /></ToolTip>
                                        </ToolTipService.ToolTip>
                                        <SymbolIcon Symbol="Refresh" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </TabViewItem>
                        <TabViewItem x:Uid="MailTextTab" Header="Text" IsClosable="False">
                            <ScrollViewer>
                                <TextBlock x:Name="BodyText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem x:Uid="MailRawTab" Header="Raw" IsClosable="False">
                            <ScrollViewer>
                                <TextBlock x:Name="RawText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
