<Page
    x:Class="HerdMe.Windows.Pages.MailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HerdMe.Windows.Models"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Mail" Style="{StaticResource TitleTextBlockStyle}" />
            <Button HorizontalAlignment="Right" Click="CopyEnvironment_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Copy" />
                    <TextBlock Text="Copy .env" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SMTP capture" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ServerStatusText" Text="Stopped" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="ServerButton" Grid.Column="1" Click="Server_Click" ToolTipService.ToolTip="Start or stop SMTP capture">
                    <SymbolIcon x:Name="ServerButtonIcon" Symbol="Play" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Inbox" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button HorizontalAlignment="Right" Click="Clear_Click" ToolTipService.ToolTip="Delete all messages">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </Grid>
                    <ListView
                        x:Name="MessageList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind Messages}"
                        SelectionChanged="MessageList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CapturedMail">
                                <StackPanel Padding="6" Spacing="3">
                                    <TextBlock Text="{x:Bind Sender}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subject}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ReceivedText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="SubjectText" Text="Select a message" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <Button x:Name="DeleteButton" HorizontalAlignment="Right" Click="Delete_Click" IsEnabled="False" ToolTipService.ToolTip="Delete message">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="SenderText" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="RecipientText" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TabView Grid.Row="3" Margin="0,8,0,0" IsAddTabButtonVisible="False">
                        <TabViewItem Header="Preview" IsClosable="False">
                            <WebView2 x:Name="HtmlPreview" />
                        </TabViewItem>
                        <TabViewItem Header="Text" IsClosable="False">
                            <ScrollViewer>
                                <TextBlock x:Name="BodyText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem Header="Raw" IsClosable="False">
                            <ScrollViewer>
                                <TextBlock x:Name="RawText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
