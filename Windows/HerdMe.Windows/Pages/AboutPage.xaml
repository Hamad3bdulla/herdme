<Page
    x:Class="HerdMe.Windows.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="HerdMe" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Open-source local development for PHP and Laravel" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Independent implementation" FontWeight="SemiBold" />
                    <TextBlock Text="HerdMe uses its own source, runtimes, certificates, settings, and application data. It does not read another application's private runtime or configuration." TextWrapping="Wrap" />
                    <TextBlock Text="License: MIT" />
                    <TextBlock Text="No activation, subscription, license key, paid tier, or feature gate." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="MIT License" Click="License_Click" />
                        <Button Content="Acknowledgements" Click="Acknowledgements_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
