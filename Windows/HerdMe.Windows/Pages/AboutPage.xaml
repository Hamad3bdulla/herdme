<Page
    x:Class="HerdMe.Windows.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="AboutPageRoot"
    AutomationProperties.AutomationId="AboutPageRoot"
    AutomationProperties.Name="About HerdMe">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock AutomationProperties.AutomationId="AboutPageRoot" Text="HerdMe" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="AboutPageDescription" Text="Open-source local development for PHP and Laravel" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="AboutIndependentTitle" Text="Independent implementation" FontWeight="SemiBold" />
                    <TextBlock x:Uid="AboutIndependentDescription" Text="HerdMe uses its own source, runtimes, certificates, settings, and application data. It does not read another application's private runtime or configuration." TextWrapping="Wrap" />
                    <TextBlock x:Uid="AboutLicenseSummary" Text="License: MIT" />
                    <TextBlock x:Uid="AboutOpenSourcePromise" Text="No activation, subscription, license key, paid tier, or feature gate." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="Repository_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip><TextBlock x:Uid="AboutRepositoryTooltip" Text="Open the source repository" /></ToolTip>
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE943;" FontSize="14" />
                                <TextBlock x:Uid="AboutRepositoryButtonText" Text="Repository" />
                            </StackPanel>
                        </Button>
                        <Button Click="Documentation_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip><TextBlock x:Uid="AboutDocumentationTooltip" Text="Open the documentation" /></ToolTip>
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE82D;" FontSize="14" />
                                <TextBlock x:Uid="AboutDocumentationButtonText" Text="Documentation" />
                            </StackPanel>
                        </Button>
                        <Button Click="ReleaseNotes_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip><TextBlock x:Uid="AboutReleaseNotesTooltip" Text="Open release notes" /></ToolTip>
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                <TextBlock x:Uid="AboutReleaseNotesButtonText" Text="Release Notes" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="CopyVersion_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip><TextBlock x:Uid="AboutCopyVersionTooltip" Text="Copy the HerdMe version and build number" /></ToolTip>
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock x:Uid="AboutCopyVersionButtonText" Text="Copy Version" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="CopyVersionStatusText" MinWidth="48" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="CheckUpdatesButton" Click="CheckUpdates_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                <TextBlock x:Uid="AboutCheckUpdatesButtonText" Text="Check for Updates" />
                            </StackPanel>
                        </Button>
                        <Grid Width="20" Height="20">
                            <ProgressRing x:Name="UpdateProgress" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="AboutLicenseButton" Content="MIT License" Click="License_Click" />
                        <Button x:Uid="AboutAcknowledgementsButton" Content="Acknowledgements" Click="Acknowledgements_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
