<Page
    x:Class="HerdMe.Windows.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="AboutPageRoot"
    AutomationProperties.AutomationId="AboutPageRoot"
    AutomationProperties.Name="About HerdMe">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <Border Style="{StaticResource CardStyle}" Padding="24,20,24,20">
                <Grid ColumnSpacing="20" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image Source="ms-appx:///Assets/HerdMe.png" Width="64" Height="64" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock AutomationProperties.AutomationId="AboutPageRoot" Text="HerdMe" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Uid="AboutPageDescription" Text="Open-source local development for PHP and Laravel" Style="{StaticResource PageSubtitleStyle}" />
                        <TextBlock x:Name="VersionText" Margin="0,4,0,0" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdatesButton" Click="CheckUpdates_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    <TextBlock x:Uid="AboutCheckUpdatesButtonText" Text="Check for Updates" />
                                </StackPanel>
                            </Button>
                            <Button Click="CopyVersion_Click">
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="AboutCopyVersionTooltip" Text="Copy the HerdMe version and build number" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock x:Uid="AboutCopyVersionButtonText" Text="Copy Version" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="WhatsNewButton" x:Uid="AboutWhatsNewButton" AutomationProperties.AutomationId="AboutWhatsNewButton" AutomationProperties.Name="What's new" Click="WhatsNew_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE789;" FontSize="14" />
                                    <TextBlock x:Uid="AboutWhatsNewButtonText" Text="What's new" />
                                </StackPanel>
                            </Button>
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <ProgressRing x:Name="UpdateProgress" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock x:Name="CopyVersionStatusText" MinWidth="48" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingsRowDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Uid="AboutResourcesTitle" Text="Resources" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsGroupStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE943;" Style="{StaticResource SettingsRowIconStyle}" />
                        <TextBlock x:Uid="AboutRepositoryTooltip" Grid.Column="1" Text="Open the source repository" VerticalAlignment="Center" Style="{StaticResource SettingsRowTitleStyle}" />
                        <Button Grid.Column="2" VerticalAlignment="Center" Click="Repository_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="AboutRepositoryButtonText" Text="Repository" />
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Rectangle Style="{StaticResource CardDividerStyle}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE82D;" Style="{StaticResource SettingsRowIconStyle}" />
                        <TextBlock x:Uid="AboutDocumentationTooltip" Grid.Column="1" Text="Open the documentation" VerticalAlignment="Center" Style="{StaticResource SettingsRowTitleStyle}" />
                        <Button Grid.Column="2" VerticalAlignment="Center" Click="Documentation_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="AboutDocumentationButtonText" Text="Documentation" />
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Rectangle Style="{StaticResource CardDividerStyle}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" Style="{StaticResource SettingsRowIconStyle}" />
                        <TextBlock x:Uid="AboutReleaseNotesTooltip" Grid.Column="1" Text="Open release notes" VerticalAlignment="Center" Style="{StaticResource SettingsRowTitleStyle}" />
                        <Button Grid.Column="2" VerticalAlignment="Center" Click="ReleaseNotes_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="AboutReleaseNotesButtonText" Text="Release Notes" />
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Uid="AboutIndependentTitle" Text="Independent implementation" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsGroupStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72E;" Style="{StaticResource SettingsRowIconStyle}" />
                        <TextBlock x:Uid="AboutIndependentDescription" Grid.Column="1" Text="HerdMe uses its own source, runtimes, certificates, settings, and application data. It does not read another application's private runtime or configuration." VerticalAlignment="Center" Style="{StaticResource SettingsRowTitleStyle}" />
                    </Grid>
                    <Rectangle Style="{StaticResource CardDividerStyle}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D7;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                            <TextBlock x:Uid="AboutLicenseSummary" Text="License: MIT" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock x:Uid="AboutOpenSourcePromise" Text="No activation, subscription, license key, paid tier, or feature gate." Style="{StaticResource SettingsRowDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource SettingsRowControlStyle}">
                            <Button x:Uid="AboutLicenseButton" Content="MIT License" Click="License_Click" />
                            <Button x:Uid="AboutAcknowledgementsButton" Content="Acknowledgements" Click="Acknowledgements_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsGroupStyle}">
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7E8;" Style="{StaticResource SettingsRowIconStyle}" />
                    <TextBlock x:Uid="AboutExitDescription" Grid.Column="1" Text="Stop local services and close HerdMe." VerticalAlignment="Center" Style="{StaticResource SettingsRowTitleStyle}" />
                    <Button Grid.Column="2" VerticalAlignment="Center" Click="Exit_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="ClosePane" />
                            <TextBlock x:Uid="AboutExitButtonText" Text="Exit HerdMe" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
