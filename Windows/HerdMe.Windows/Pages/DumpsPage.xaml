<Page
    x:Class="HerdMe.Windows.Pages.DumpsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HerdMe.Windows.Models"
    AutomationProperties.AutomationId="DumpsPageRoot"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="2" Margin="0,0,0,4">
            <TextBlock x:Uid="DumpsPageTitle" AutomationProperties.AutomationId="DumpsPageRoot" Text="Dumps" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="DumpsPageSubtitle" Text="Review dump() output captured from your local sites." Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SettingsGroupStyle}">
            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTileStyle}" Background="{ThemeResource DumpsTintBrush}" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource DumpsInkBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                    <TextBlock x:Uid="DumpsCaptureTitle" Text="VarDumper capture" FontWeight="SemiBold" Style="{StaticResource SettingsRowTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="ServerStatusDot" Style="{StaticResource StatusDotNeutralStyle}" />
                        <TextBlock x:Name="ServerStatusText" x:Uid="DumpsStoppedInitial" Text="Stopped" Style="{StaticResource SettingsRowDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ServerButton" x:Uid="DumpsServerButton" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="Start or stop dump capture" Click="Server_Click" Style="{StaticResource ToolbarIconButtonStyle}">
                    <ToolTipService.ToolTip>
                        <ToolTip><TextBlock x:Uid="DumpsServerTooltip" Text="Start or stop dump capture" /></ToolTip>
                    </ToolTipService.ToolTip>
                    <SymbolIcon x:Name="ServerButtonIcon" Symbol="Play" />
                </Button>
            </Grid>
        </Border>

        <InfoBar x:Name="CaptureErrorBar" Grid.Row="2" IsOpen="False" Severity="Error">
            <InfoBar.ActionButton>
                <Button x:Uid="DumpsCaptureRetryButton" Content="Reload" Click="RetryLoad_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220" MaxWidth="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource ToolPaneStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14,8,8,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="DumpsCapturedTitle" Text="Captured" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <ProgressRing x:Name="CaptureProgress" x:Uid="DumpsCaptureProgress" Width="18" Height="18" Margin="0,0,6,0" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Loading captured data" />
                            <Button x:Uid="DumpsCaptureRefreshButton" Click="RetryLoad_Click" Style="{StaticResource ToolbarIconButtonStyle}" AutomationProperties.Name="Refresh captured data">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F5" />
                                </Button.KeyboardAccelerators>
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="DumpsCaptureRefreshTooltip" Text="Refresh" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <SymbolIcon Symbol="Refresh" />
                            </Button>
                            <Button x:Name="ClearButton" x:Uid="DumpsClearButton" Click="Clear_Click" AutomationProperties.Name="Delete all dumps" Style="{StaticResource DangerToolbarIconButtonStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="DumpsClearTooltip" Text="Delete all dumps" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListView
                        x:Name="DumpList"
                        Grid.Row="1"
                        Padding="0,4,0,4"
                        ItemsSource="{x:Bind Dumps}"
                        SelectionChanged="DumpList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CapturedDump">
                                <StackPanel Padding="0,4" Spacing="2">
                                    <TextBlock Text="{x:Bind SourcePreview}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SummaryPreview}" MaxLines="2" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" FontSize="12" FlowDirection="LeftToRight" />
                                    <TextBlock Text="{x:Bind ReceivedText}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="EmptyState" Grid.Row="1" Spacing="8" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                        <FontIcon Glyph="&#xE9D9;" Style="{StaticResource EmptyStateGlyphStyle}" />
                        <TextBlock x:Uid="DumpsInboxEmpty" Text="No captured dumps yet" TextAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource ToolPaneStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,8,8,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SourceText" x:Uid="DumpsSelectDumpInitial" Text="Select a dump" VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="ExportButton" x:Uid="DumpsExportButton" Grid.Column="1" Click="Export_Click" IsEnabled="False" Style="{StaticResource ToolbarIconButtonStyle}" AutomationProperties.Name="Export full dump">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="S" />
                            </Button.KeyboardAccelerators>
                            <ToolTipService.ToolTip>
                                <ToolTip><TextBlock x:Uid="DumpsExportTooltip" Text="Export full dump" /></ToolTip>
                            </ToolTipService.ToolTip>
                            <SymbolIcon Symbol="Save" />
                        </Button>
                    </Grid>
                    <InfoBar x:Name="PreviewSizeNotice" x:Uid="DumpsPreviewSizeNotice" Grid.Row="1" Margin="12,0,12,8" IsOpen="False" IsClosable="False" Severity="Informational" Message="This view is shortened. Export the dump to save its full contents." />
                    <Border Grid.Row="2" Background="{ThemeResource SubtleSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Tree for browsing nested arrays, objects and JSON strings; Text is the full rendering. -->
                            <Grid Padding="8,2,12,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SelectorBar x:Name="DumpViewTabs" AutomationProperties.AutomationId="DumpViewTabs" SelectionChanged="DumpViewTabs_SelectionChanged">
                                    <SelectorBarItem x:Name="DumpTreeTab" x:Uid="DumpTreeTab" Tag="tree" Text="Tree" IsSelected="True" />
                                    <SelectorBarItem x:Name="DumpTextTab" x:Uid="DumpTextTab" Tag="text" Text="Text" />
                                </SelectorBar>
                                <StackPanel x:Name="DumpTreeTools" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button x:Uid="DumpExpandAllButton" Click="DumpExpandAll_Click" Style="{StaticResource ToolbarIconButtonStyle}" AutomationProperties.Name="Expand all">
                                        <ToolTipService.ToolTip>
                                            <ToolTip><TextBlock x:Uid="DumpExpandAllTooltip" Text="Expand all" /></ToolTip>
                                        </ToolTipService.ToolTip>
                                        <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                                    </Button>
                                    <Button x:Uid="DumpCollapseAllButton" Click="DumpCollapseAll_Click" Style="{StaticResource ToolbarIconButtonStyle}" AutomationProperties.Name="Collapse all">
                                        <ToolTipService.ToolTip>
                                            <ToolTip><TextBlock x:Uid="DumpCollapseAllTooltip" Text="Collapse all" /></ToolTip>
                                        </ToolTipService.ToolTip>
                                        <FontIcon Glyph="&#xE8A8;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TreeView
                                x:Name="DumpTreeView"
                                Grid.Row="1"
                                Padding="4,4,8,8"
                                SelectionMode="None"
                                FlowDirection="LeftToRight"
                                Expanding="DumpTreeView_Expanding"
                                AutomationProperties.AutomationId="DumpTreeView" />
                            <TextBlock x:Name="DumpTreeEmpty" x:Uid="DumpTreeEmpty" Grid.Row="1" Margin="16" Visibility="Collapsed" Text="This dump has no structure to browse. Switch to Text." TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                            <ScrollViewer x:Name="SummaryScroll" Grid.Row="1" Padding="16,12,16,12" Visibility="Collapsed">
                                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" FlowDirection="LeftToRight" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
