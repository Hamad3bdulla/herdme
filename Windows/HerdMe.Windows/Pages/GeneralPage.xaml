<Page
    x:Class="HerdMe.Windows.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HerdMe.Windows.Models"
    AutomationProperties.AutomationId="GeneralPageRoot"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">
            <Grid>
                <TextBlock x:Uid="GeneralPageTitle" AutomationProperties.AutomationId="GeneralPageRoot" Text="General" Style="{StaticResource TitleTextBlockStyle}" />
                <Button HorizontalAlignment="Right" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock x:Uid="GeneralRefresh" Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Uid="GeneralLaunchAtSigninTitle" Text="Launch at sign-in" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Uid="GeneralLaunchAtSigninDescription" Text="Keep local sites available after signing in to Windows." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Toggled="StartupToggle_Toggled" />
                </Grid>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="GeneralLocalDomainsTitle" Text="Local domains" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="DomainsStatusText" x:Uid="GeneralDomainsChecking" Text="Checking" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RemoveDomainsButton" x:Uid="GeneralRemoveDomains" Content="Remove" Click="RemoveDomains_Click" />
                            <Button x:Name="InstallDomainsButton" x:Uid="GeneralSetupDomains" Content="Set Up" Click="InstallDomains_Click" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="GeneralHttpsCertificateTitle" Text="HTTPS certificate" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="CertificateStatusText" x:Uid="GeneralCertificateChecking" Text="Checking" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            x:Name="TrustCertificateButton"
                            x:Uid="GeneralTrustCertificate"
                            Grid.Column="1"
                            Content="Trust"
                            Click="TrustCertificate_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="GeneralApplicationUpdatesTitle" Text="Application updates" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="UpdateStatusText" x:Uid="GeneralStableChannel" Text="Stable channel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ProgressRing x:Name="UpdateProgress" Grid.Column="1" Width="18" Height="18" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="GeneralCheckAutomatically" Text="Check automatically" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="AutomaticUpdatesToggle" Grid.Column="1" Toggled="AutomaticUpdatesToggle_Toggled" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="GeneralUpdateChannel" Text="Update channel" VerticalAlignment="Center" />
                        <ComboBox x:Name="UpdateChannelBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="UpdateChannelBox_SelectionChanged">
                            <ComboBoxItem x:Uid="GeneralStableOption" Content="Stable" Tag="Stable" />
                            <ComboBoxItem x:Uid="GeneralBetaOption" Content="Beta" Tag="Beta" />
                        </ComboBox>
                    </Grid>
                    <Button x:Name="CheckNowButton" HorizontalAlignment="Right" Click="CheckNow_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Sync" />
                            <TextBlock x:Uid="GeneralCheckNow" Text="Check Now" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="GeneralPortableCoreTitle" Text="Portable core" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="GeneralStatusLabel" Text="Status" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="CoreProgress" Width="16" Height="16" />
                            <TextBlock x:Name="CoreStatusText" x:Uid="GeneralCoreChecking" Text="Checking" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="GeneralExecutableLabel" Text="Executable" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="CoreExecutableText" Grid.Column="1" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="GeneralApplicationDataLabel" Text="Application data" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="SupportPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="OpenDataButton"
                                IsEnabled="False"
                                Click="OpenData_Click">
                                <SymbolIcon Symbol="OpenLocal" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="GeneralRuntimeCheckTitle" Text="Runtime check" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView ItemsSource="{x:Bind Runtimes}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RuntimeCheck">
                                <Grid Padding="4" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="GeneralLaravelExtensionsTitle" Text="Laravel PHP extensions" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="PhpExtensionProgress" Width="16" Height="16" />
                        <TextBlock x:Name="PhpExtensionStatusText" x:Uid="GeneralPhpUnavailable" Text="PHP unavailable" />
                    </StackPanel>
                    <TextBlock
                        x:Name="PhpExtensionDetailText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
