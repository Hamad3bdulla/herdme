<Page
    x:Class="HerdMe.Windows.Pages.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HerdMe.Windows.Models"
    AutomationProperties.AutomationId="ServicesPageRoot"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="ServicesPageTitle" AutomationProperties.AutomationId="ServicesPageRoot" Text="Services" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="ServicesPageDescription" Text="Checksum-verified open-source Windows service runtimes" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="OperationProgress" Width="18" Height="18" />
                <TextBlock x:Name="OperationStatusText" VerticalAlignment="Center" MaxWidth="180" TextWrapping="Wrap" />
                <Button x:Name="CancelOperationButton" Click="CancelOperation_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Cancel" />
                        <TextBlock x:Uid="CommonCancel" Text="Cancel" />
                    </StackPanel>
                </Button>
                <Button Click="Refresh_Click" Style="{StaticResource ToolbarIconButtonStyle}">
                    <ToolTipService.ToolTip>
                        <ToolTip><TextBlock x:Uid="ServicesRefreshTooltip" Text="Refresh service status" /></ToolTip>
                    </ToolTipService.ToolTip>
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SectionDividerStyle}">
            <Grid ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Uid="ServicesTypeField"
                    x:Name="ServiceTypeBox"
                    Header="Service"
                    ItemsSource="{x:Bind Definitions}"
                    DisplayMemberPath="Name"
                    SelectionChanged="ServiceType_SelectionChanged" />
                <TextBox x:Uid="ServicesNameField" x:Name="ServiceNameBox" Grid.Column="1" Header="Name" TextWrapping="Wrap" />
                <NumberBox x:Uid="ServicesPortField" x:Name="ServicePortBox" Grid.Column="2" Header="Port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                <Button
                    x:Name="AddServiceButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Grid.Column="3"
                    VerticalAlignment="Bottom"
                    Click="Add_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock x:Uid="ServicesAddButton" Text="Add" />
                    </StackPanel>
                </Button>
                <TextBlock
                    x:Name="ServiceAvailabilityText"
                    Grid.Row="1"
                    Grid.ColumnSpan="4"
                    Margin="0,10,0,0"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SectionDividerStyle}">
            <Grid>
                <ListView x:Name="ServiceList" ItemsSource="{x:Bind Rows}">
                    <ListView.Header>
                        <Grid Padding="18,6" ColumnSpacing="10" Background="{ThemeResource SubtleSurfaceBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="100" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="ServicesServiceColumn" Text="Service" FontWeight="SemiBold" />
                            <TextBlock x:Uid="ServicesPortColumn" Grid.Column="1" Text="Port" FontWeight="SemiBold" />
                            <TextBlock x:Uid="ServicesVersionColumn" Grid.Column="2" Text="Version" FontWeight="SemiBold" />
                            <TextBlock x:Uid="ServicesStatusColumn" Grid.Column="3" Text="Status" FontWeight="SemiBold" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ManagedServiceRow">
                            <Grid Padding="10,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="100" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Subtitle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Port}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Version}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                                        Tag="{x:Bind Id}"
                                        Click="Install_Click"
                                        AutomationProperties.Name="{x:Bind InstallLabel}"
                                        Visibility="{x:Bind CanInstallOrUpdate}">
                                        <ToolTipService.ToolTip>
                                            <ToolTip><TextBlock x:Uid="ServicesInstallTooltip" Text="Install or update runtime" /></ToolTip>
                                        </ToolTipService.ToolTip>
                                        <SymbolIcon Symbol="Download" />
                                    </Button>
                                    <Button Tag="{x:Bind Id}" Click="Toggle_Click" IsEnabled="{x:Bind CanToggle}">
                                        <TextBlock Text="{x:Bind ToggleLabel}" />
                                    </Button>
                                    <Button IsEnabled="{x:Bind CanManage}" Style="{StaticResource ToolbarIconButtonStyle}">
                                        <ToolTipService.ToolTip>
                                            <ToolTip><TextBlock x:Uid="ServicesMoreTooltip" Text="More service actions" /></ToolTip>
                                        </ToolTipService.ToolTip>
                                        <SymbolIcon Symbol="More" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <ToggleMenuFlyoutItem
                                                    x:Uid="ServicesAutomaticStartMenu"
                                                    Text="Start automatically"
                                                    Tag="{x:Bind Id}"
                                                    IsChecked="{x:Bind StartAutomatically, Mode=OneTime}"
                                                    Click="AutomaticStart_Toggled" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    x:Uid="ServicesOpenDataTooltip"
                                                    Text="Open data directory"
                                                    Tag="{x:Bind Id}"
                                                    Click="OpenData_Click">
                                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Folder" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    x:Uid="ServicesInspectPortMenu"
                                                    Text="Inspect port"
                                                    Tag="{x:Bind Id}"
                                                    Click="InspectPort_Click">
                                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Find" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    x:Uid="ServicesEnvironmentTooltip"
                                                    Text="Add service connection to a site .env"
                                                    Tag="{x:Bind Id}"
                                                    Click="AddToEnvironment_Click">
                                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Edit" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    x:Uid="ServicesConsoleTooltip"
                                                    Text="Open service console"
                                                    Tag="{x:Bind Id}"
                                                    Click="OpenConsole_Click"
                                                    Visibility="{x:Bind CanOpenConsole}" />
                                                <MenuFlyoutItem
                                                    x:Uid="ServicesCopyConnectionTooltip"
                                                    Text="Copy database connection URL"
                                                    Tag="{x:Bind Id}"
                                                    Click="CopyConnection_Click"
                                                    Visibility="{x:Bind CanOpenInTablePlus}">
                                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    x:Uid="ServicesTablePlusTooltip"
                                                    Text="Open database in TablePlus"
                                                    Tag="{x:Bind Id}"
                                                    Click="OpenTablePlus_Click"
                                                    Visibility="{x:Bind CanOpenInTablePlus}" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    x:Uid="ServicesDeleteTooltip"
                                                    Text="Delete service instance"
                                                    Tag="{x:Bind Id}"
                                                    Click="Delete_Click">
                                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <SymbolIcon Symbol="Library" />
                    <TextBlock x:Uid="ServicesEmptyState" Text="No services added" Style="{StaticResource SectionTitleStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
