<Page
    x:Class="HerdMe.Windows.Pages.PhpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="PhpPageRoot"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <Grid>
                <TextBlock x:Uid="PhpPageTitle" Text="PHP" Style="{StaticResource TitleTextBlockStyle}" />
                <Button HorizontalAlignment="Right" Click="Refresh_Click">
                    <ToolTipService.ToolTip>
                        <ToolTip><TextBlock x:Uid="PhpRefreshTooltip" Text="Refresh PHP status" /></ToolTip>
                    </ToolTipService.ToolTip>
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </Grid>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="PhpLaravelRuntimeTitle" Text="Laravel runtime" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox
                            x:Name="PhpCycleBox"
                            Width="120"
                            SelectionChanged="PhpCycle_SelectionChanged" />
                        <Button x:Name="InstallPhpButton" Click="InstallPhp_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Download" />
                                <TextBlock x:Name="InstallPhpButtonText" x:Uid="PhpInstallButton" Text="Install" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="PhpPathText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="RuntimeProgress" Width="16" Height="16" />
                        <TextBlock x:Name="RuntimeStatusText" x:Uid="PhpChecking" Text="Checking" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="ExtensionDetailText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock x:Uid="PhpToolsTitle" Text="Composer and Laravel Installer" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="ComposerVersionText" x:Uid="PhpComposerNotInstalled" Text="Composer: Not installed" />
                        <TextBlock x:Name="LaravelInstallerVersionText" x:Uid="PhpLaravelInstallerNotInstalled" Text="Laravel Installer: Not installed" />
                    </StackPanel>
                    <Button x:Name="InstallToolsButton" Grid.Column="1" VerticalAlignment="Center" Click="InstallTools_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Download" />
                            <TextBlock x:Name="InstallToolsButtonText" x:Uid="PhpInstallToolsButton" Text="Install" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="PhpRequestLimitsTitle" Text="Request limits" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="PhpMemoryLimitLabel" Text="Memory limit (MB)" VerticalAlignment="Center" />
                        <NumberBox x:Name="MemoryLimitBox" Grid.Column="1" Minimum="16" Maximum="100000" SpinButtonPlacementMode="Compact" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="PhpUploadLimitLabel" Text="Maximum upload (MB)" VerticalAlignment="Center" />
                        <NumberBox x:Name="UploadLimitBox" Grid.Column="1" Minimum="1" Maximum="100000" SpinButtonPlacementMode="Compact" />
                    </Grid>
                    <Button x:Name="SaveButton" HorizontalAlignment="Left" Click="Save_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Save" />
                            <TextBlock x:Uid="PhpSaveButton" Text="Save" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="SaveStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
