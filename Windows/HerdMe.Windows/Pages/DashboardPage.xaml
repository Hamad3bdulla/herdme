<Page
    x:Class="HerdMe.Windows.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="DashboardPageRoot"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <Style x:Key="DashboardSummaryCardStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="136" />
            <Setter Property="Padding" Value="16,14,16,14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        </Style>
        <Style x:Key="DashboardSummaryCountStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="34" />
        </Style>
        <Style x:Key="DashboardSummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DashboardSummaryStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DashboardCardChevronStyle" TargetType="FontIcon">
            <Setter Property="Glyph" Value="&#xE76C;" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MirroredWhenRightToLeft" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="DashboardRowIconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="DashboardRowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>
    <Grid x:Name="DashboardLayout" Padding="{StaticResource PagePadding}" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="DashboardPageTitle" AutomationProperties.AutomationId="DashboardPageRoot" Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    x:Uid="DashboardPageSubtitle"
                    Text="Your local development environment at a glance."
                    Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="RefreshProgress" Width="18" Height="18" />
                <Button
                    x:Uid="DashboardRefreshButton"
                    x:Name="RefreshButton"
                    Click="Refresh_Click"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    AutomationProperties.Name="Refresh dashboard">
                    <ToolTipService.ToolTip>
                        <ToolTip><TextBlock x:Uid="DashboardRefreshTooltip" Text="Refresh dashboard" /></ToolTip>
                    </ToolTipService.ToolTip>
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="0,0,0,8">
                <!-- Repair all runs in the background; this shows the current step and lets the user cancel. -->
                <InfoBar
                    x:Uid="DashboardRepairProgressInfoBar"
                    x:Name="RepairProgressInfoBar"
                    Title="Repairing the environment"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button
                            x:Uid="DashboardRepairCancelButton"
                            x:Name="RepairCancelButton"
                            Content="Cancel"
                            Click="RepairCancel_Click"
                            AutomationProperties.Name="Cancel repair" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <StackPanel Spacing="6" Margin="0,0,0,12">
                            <TextBlock
                                x:Name="RepairProgressText"
                                TextWrapping="Wrap"
                                AutomationProperties.LiveSetting="Polite" />
                            <TextBlock
                                x:Name="RepairProgressCountText"
                                Style="{StaticResource CaptionTextStyle}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <ProgressBar x:Name="RepairProgressIndicator" IsIndeterminate="True" Minimum="0" Maximum="1" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
                <InfoBar x:Name="RepairResultInfoBar" IsOpen="False" IsClosable="True" Severity="Success" />
                <!-- Health summary: one card that says whether the environment can be trusted. -->
                <Border x:Name="HealthCard" Style="{StaticResource CardStyle}" Padding="20,18,20,18">
                    <Grid x:Name="HealthGrid" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="HealthIconTile"
                            Style="{StaticResource StatusPillNeutralStyle}"
                            Width="44"
                            Height="44"
                            Padding="0"
                            CornerRadius="22"
                            VerticalAlignment="Top">
                            <FontIcon
                                x:Name="HealthGlyph"
                                Glyph="&#xE946;"
                                Style="{StaticResource StatusGlyphNeutralStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                x:Uid="DashboardHealthTitle"
                                x:Name="HealthTitle"
                                Text="Checking the environment..."
                                FontSize="18"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="HealthMessage" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            x:Name="HealthActions"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Button
                                x:Uid="DashboardRepairAllButton"
                                x:Name="RepairAllButton"
                                Click="RepairAll_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Repair" />
                                    <TextBlock x:Uid="DashboardRepairAllButtonText" Text="Repair all" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Uid="DashboardMoreActionsButton"
                                x:Name="MoreActionsButton"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                Height="32"
                                AutomationProperties.Name="More actions">
                                <ToolTipService.ToolTip>
                                    <ToolTip><TextBlock x:Uid="DashboardMoreActionsTooltip" Text="More actions" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem x:Uid="DashboardRetryFailedButtonText" Text="Retry failed only" Click="RetryFailed_Click">
                                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Sync" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="DashboardExportDiagnosticsButtonText" Text="Export diagnostics" Click="ExportDiagnostics_Click">
                                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Download" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <StackPanel
                            x:Name="WarningPanel"
                            Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Margin="0,16,0,0"
                            Spacing="12"
                            Visibility="Collapsed">
                            <Rectangle Style="{StaticResource CardDividerStyle}" />
                            <StackPanel x:Name="WarningList" Spacing="10" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="SummaryCardsGrid" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SummaryColumn0" Width="*" />
                        <ColumnDefinition x:Name="SummaryColumn1" Width="*" />
                        <ColumnDefinition x:Name="SummaryColumn2" Width="*" />
                        <ColumnDefinition x:Name="SummaryColumn3" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        x:Uid="DashboardSitesCard"
                        x:Name="SitesCard"
                        Click="OpenSites_Click"
                        Style="{StaticResource DashboardSummaryCardStyle}"
                        AutomationProperties.Name="Open sites">
                        <Grid RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource IconTileStyle}" Width="36" Height="36" HorizontalAlignment="Left" Background="{ThemeResource SitesTintBrush}">
                                <SymbolIcon Symbol="Folder" Foreground="{ThemeResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <FontIcon Style="{StaticResource DashboardCardChevronStyle}" />
                            <TextBlock x:Name="SitesCountText" Grid.Row="1" Margin="0,12,0,0" Text="0" Visibility="Collapsed" Style="{StaticResource DashboardSummaryCountStyle}" />
                            <Border x:Name="SitesCountSkeleton" Grid.Row="1" Margin="0,16,0,6" Width="44" Height="24" Style="{StaticResource SkeletonBlockStyle}" />
                            <TextBlock x:Uid="DashboardSitesLabel" Grid.Row="2" Text="Sites" Style="{StaticResource DashboardSummaryLabelStyle}" />
                            <StackPanel Grid.Row="3" Margin="0,8,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Ellipse x:Name="SitesStatusDot" Style="{StaticResource StatusDotNeutralStyle}" />
                                <TextBlock x:Name="SitesStatusText" Style="{StaticResource DashboardSummaryStatusStyle}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button
                        x:Uid="DashboardServicesCard"
                        x:Name="ServicesCard"
                        Grid.Column="1"
                        Click="OpenServices_Click"
                        Style="{StaticResource DashboardSummaryCardStyle}"
                        AutomationProperties.Name="Open services">
                        <Grid RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource IconTileStyle}" Width="36" Height="36" HorizontalAlignment="Left" Background="{ThemeResource ServicesTintBrush}">
                                <SymbolIcon Symbol="AllApps" Foreground="{ThemeResource ServicesInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <FontIcon Style="{StaticResource DashboardCardChevronStyle}" />
                            <TextBlock x:Name="ServicesCountText" Grid.Row="1" Margin="0,12,0,0" Text="0" Visibility="Collapsed" Style="{StaticResource DashboardSummaryCountStyle}" />
                            <Border x:Name="ServicesCountSkeleton" Grid.Row="1" Margin="0,16,0,6" Width="44" Height="24" Style="{StaticResource SkeletonBlockStyle}" />
                            <TextBlock x:Uid="DashboardServicesLabel" Grid.Row="2" Text="Services" Style="{StaticResource DashboardSummaryLabelStyle}" />
                            <StackPanel Grid.Row="3" Margin="0,8,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Ellipse x:Name="ServicesStatusDot" Style="{StaticResource StatusDotNeutralStyle}" />
                                <TextBlock x:Name="ServicesStatusText" Style="{StaticResource DashboardSummaryStatusStyle}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button
                        x:Uid="DashboardMailCard"
                        x:Name="MailCard"
                        Grid.Column="2"
                        Click="OpenMail_Click"
                        Style="{StaticResource DashboardSummaryCardStyle}"
                        AutomationProperties.Name="Open mail">
                        <Grid RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource IconTileStyle}" Width="36" Height="36" HorizontalAlignment="Left" Background="{ThemeResource MailTintBrush}">
                                <SymbolIcon Symbol="Mail" Foreground="{ThemeResource MailInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <FontIcon Style="{StaticResource DashboardCardChevronStyle}" />
                            <TextBlock x:Name="MailCountText" Grid.Row="1" Margin="0,12,0,0" Text="0" Visibility="Collapsed" Style="{StaticResource DashboardSummaryCountStyle}" />
                            <Border x:Name="MailCountSkeleton" Grid.Row="1" Margin="0,16,0,6" Width="44" Height="24" Style="{StaticResource SkeletonBlockStyle}" />
                            <TextBlock x:Uid="DashboardMailLabel" Grid.Row="2" Text="Mail" Style="{StaticResource DashboardSummaryLabelStyle}" />
                            <StackPanel Grid.Row="3" Margin="0,8,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Ellipse x:Name="MailStatusDot" Style="{StaticResource StatusDotNeutralStyle}" />
                                <TextBlock x:Name="MailStatusText" Style="{StaticResource DashboardSummaryStatusStyle}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button
                        x:Uid="DashboardDumpsCard"
                        x:Name="DumpsCard"
                        Grid.Column="3"
                        Click="OpenDumps_Click"
                        Style="{StaticResource DashboardSummaryCardStyle}"
                        AutomationProperties.Name="Open dumps">
                        <Grid RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource IconTileStyle}" Width="36" Height="36" HorizontalAlignment="Left" Background="{ThemeResource DumpsTintBrush}">
                                <SymbolIcon Symbol="View" Foreground="{ThemeResource DumpsInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <FontIcon Style="{StaticResource DashboardCardChevronStyle}" />
                            <TextBlock x:Name="DumpsCountText" Grid.Row="1" Margin="0,12,0,0" Text="0" Visibility="Collapsed" Style="{StaticResource DashboardSummaryCountStyle}" />
                            <Border x:Name="DumpsCountSkeleton" Grid.Row="1" Margin="0,16,0,6" Width="44" Height="24" Style="{StaticResource SkeletonBlockStyle}" />
                            <TextBlock x:Uid="DashboardDumpsLabel" Grid.Row="2" Text="Dumps" Style="{StaticResource DashboardSummaryLabelStyle}" />
                            <StackPanel Grid.Row="3" Margin="0,8,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Ellipse x:Name="DumpsStatusDot" Style="{StaticResource StatusDotNeutralStyle}" />
                                <TextBlock x:Name="DumpsStatusText" Style="{StaticResource DashboardSummaryStatusStyle}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <TextBlock x:Uid="DashboardEnvironmentSectionTitle" Text="Environment" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <Grid x:Name="EnvironmentRow" Padding="16,14,16,14" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" Style="{StaticResource DashboardRowIconTileStyle}">
                                <FontIcon Glyph="&#xE774;" FontSize="16" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Uid="DashboardEnvironmentLabel" x:Name="EnvironmentLabelText" Text="Sites environment" Style="{StaticResource DashboardRowLabelStyle}" />
                                <TextBlock x:Name="EnvironmentDetailText" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                            </StackPanel>
                            <Border x:Name="EnvironmentStatusPill" Grid.Column="2" Style="{StaticResource StatusPillNeutralStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse x:Name="EnvironmentStatusDot" Style="{StaticResource StatusDotNeutralStyle}" />
                                    <TextBlock x:Name="EnvironmentStatusText" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Rectangle Style="{StaticResource CardDividerStyle}" />
                        <Grid x:Name="DomainsRow" Padding="16,14,16,14" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" Style="{StaticResource DashboardRowIconTileStyle}">
                                <FontIcon Glyph="&#xE71B;" FontSize="16" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Uid="DashboardDomainsLabel" x:Name="DomainsLabelText" Text="Local domains" Style="{StaticResource DashboardRowLabelStyle}" />
                                <TextBlock x:Name="DomainsDetailText" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                            </StackPanel>
                            <Border x:Name="DomainsStatusPill" Grid.Column="2" Style="{StaticResource StatusPillNeutralStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse x:Name="DomainsStatusDot" Style="{StaticResource StatusDotNeutralStyle}" />
                                    <TextBlock x:Name="DomainsStatusText" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Rectangle Style="{StaticResource CardDividerStyle}" />
                        <Grid x:Name="CertificateRow" Padding="16,14,16,14" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" Style="{StaticResource DashboardRowIconTileStyle}">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Uid="DashboardCertificateLabel" x:Name="CertificateLabelText" Text="HTTPS certificate" Style="{StaticResource DashboardRowLabelStyle}" />
                                <TextBlock x:Name="CertificateDetailText" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                            </StackPanel>
                            <Border x:Name="CertificateStatusPill" Grid.Column="2" Style="{StaticResource StatusPillNeutralStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse x:Name="CertificateStatusDot" Style="{StaticResource StatusDotNeutralStyle}" />
                                    <TextBlock x:Name="CertificateStatusText" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Uid="DashboardRecentActivityTitle" Text="Recent activity" Style="{StaticResource SectionHeaderStyle}" />
                <Grid x:Name="RecentActivityGrid" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon Symbol="Mail" Foreground="{ThemeResource MailInkBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="DashboardRecentMailTitle" Grid.Column="1" Text="Mail" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Uid="DashboardOpenMailButton" Grid.Column="2" Content="View all" Style="{StaticResource SubtleButtonStyle}" Click="OpenMail_Click" />
                            </Grid>
                            <StackPanel x:Name="RecentMailItems" Spacing="12" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="RecentDumpsPanel" Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon Symbol="View" Foreground="{ThemeResource DumpsInkBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="DashboardRecentDumpsTitle" Grid.Column="1" Text="Dumps" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Uid="DashboardOpenDumpsButton" Grid.Column="2" Content="View all" Style="{StaticResource SubtleButtonStyle}" Click="OpenDumps_Click" />
                            </Grid>
                            <StackPanel x:Name="RecentDumpItems" Spacing="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
