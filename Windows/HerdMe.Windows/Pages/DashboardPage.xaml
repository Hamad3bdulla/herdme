<Page
    x:Class="HerdMe.Windows.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="DashboardPageRoot"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <Style x:Key="DashboardSummaryCardStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="148" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="DashboardSummaryCountStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DashboardSummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DashboardSummaryStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>
    <Grid x:Name="DashboardLayout" Padding="28,22,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="DashboardPageTitle" AutomationProperties.AutomationId="DashboardPageRoot" Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="DashboardPageSubtitle"
                    Text="Your local development environment at a glance."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="RefreshProgress" Width="18" Height="18" />
                <Button
                    x:Uid="DashboardRefreshButton"
                    x:Name="RefreshButton"
                    Click="Refresh_Click"
                    AutomationProperties.Name="Refresh dashboard">
                    <ToolTipService.ToolTip>
                        <ToolTip><TextBlock x:Uid="DashboardRefreshTooltip" Text="Refresh dashboard" /></ToolTip>
                    </ToolTipService.ToolTip>
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <InfoBar x:Name="HealthBanner" IsOpen="True" IsClosable="False" />
                <StackPanel x:Name="WarningList" Spacing="8" Visibility="Collapsed" />

                <Grid x:Name="SummaryCardsGrid" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SummaryColumn0" Width="*" />
                        <ColumnDefinition x:Name="SummaryColumn1" Width="*" />
                        <ColumnDefinition x:Name="SummaryColumn2" Width="*" />
                        <ColumnDefinition x:Name="SummaryColumn3" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        x:Uid="DashboardSitesCard"
                        x:Name="SitesCard"
                        Click="OpenSites_Click"
                        Style="{StaticResource DashboardSummaryCardStyle}"
                        AutomationProperties.Name="Open sites">
                        <Grid MinHeight="114">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <SymbolIcon Symbol="Folder" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="SitesCountText" Grid.Column="1" Text="0" HorizontalAlignment="Right" Style="{StaticResource DashboardSummaryCountStyle}" />
                            </Grid>
                            <TextBlock x:Uid="DashboardSitesLabel" Grid.Row="1" Margin="0,14,0,0" Text="Sites" Style="{StaticResource DashboardSummaryLabelStyle}" />
                            <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="8" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="SitesStatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorNeutralBrush}" />
                                <TextBlock x:Name="SitesStatusText" Grid.Column="1" Style="{StaticResource DashboardSummaryStatusStyle}" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button
                        x:Uid="DashboardServicesCard"
                        x:Name="ServicesCard"
                        Grid.Column="1"
                        Click="OpenServices_Click"
                        Style="{StaticResource DashboardSummaryCardStyle}"
                        AutomationProperties.Name="Open services">
                        <Grid MinHeight="114">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <SymbolIcon Symbol="AllApps" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="ServicesCountText" Grid.Column="1" Text="0" HorizontalAlignment="Right" Style="{StaticResource DashboardSummaryCountStyle}" />
                            </Grid>
                            <TextBlock x:Uid="DashboardServicesLabel" Grid.Row="1" Margin="0,14,0,0" Text="Services" Style="{StaticResource DashboardSummaryLabelStyle}" />
                            <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="8" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="ServicesStatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorNeutralBrush}" />
                                <TextBlock x:Name="ServicesStatusText" Grid.Column="1" Style="{StaticResource DashboardSummaryStatusStyle}" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button
                        x:Uid="DashboardMailCard"
                        x:Name="MailCard"
                        Grid.Column="2"
                        Click="OpenMail_Click"
                        Style="{StaticResource DashboardSummaryCardStyle}"
                        AutomationProperties.Name="Open mail">
                        <Grid MinHeight="114">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <SymbolIcon Symbol="Mail" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="MailCountText" Grid.Column="1" Text="0" HorizontalAlignment="Right" Style="{StaticResource DashboardSummaryCountStyle}" />
                            </Grid>
                            <TextBlock x:Uid="DashboardMailLabel" Grid.Row="1" Margin="0,14,0,0" Text="Mail" Style="{StaticResource DashboardSummaryLabelStyle}" />
                            <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="8" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="MailStatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorNeutralBrush}" />
                                <TextBlock x:Name="MailStatusText" Grid.Column="1" Style="{StaticResource DashboardSummaryStatusStyle}" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button
                        x:Uid="DashboardDumpsCard"
                        x:Name="DumpsCard"
                        Grid.Column="3"
                        Click="OpenDumps_Click"
                        Style="{StaticResource DashboardSummaryCardStyle}"
                        AutomationProperties.Name="Open dumps">
                        <Grid MinHeight="114">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <SymbolIcon Symbol="View" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="DumpsCountText" Grid.Column="1" Text="0" HorizontalAlignment="Right" Style="{StaticResource DashboardSummaryCountStyle}" />
                            </Grid>
                            <TextBlock x:Uid="DashboardDumpsLabel" Grid.Row="1" Margin="0,14,0,0" Text="Dumps" Style="{StaticResource DashboardSummaryLabelStyle}" />
                            <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="8" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="DumpsStatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorNeutralBrush}" />
                                <TextBlock x:Name="DumpsStatusText" Grid.Column="1" Style="{StaticResource DashboardSummaryStatusStyle}" />
                            </Grid>
                        </Grid>
                    </Button>
                </Grid>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="DashboardEnvironmentSectionTitle" Text="Environment" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid x:Name="EnvironmentGrid" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="EnvironmentLabelColumn" Width="170" />
                                <ColumnDefinition x:Name="EnvironmentStatusColumn" Width="140" />
                                <ColumnDefinition x:Name="EnvironmentDetailColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="DashboardEnvironmentLabel" x:Name="EnvironmentLabelText" Text="Sites environment" Padding="0,8" FontWeight="SemiBold" />
                            <TextBlock x:Name="EnvironmentStatusText" Grid.Column="1" Padding="0,8" />
                            <TextBlock x:Name="EnvironmentDetailText" Grid.Column="2" Padding="0,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="DashboardDomainsLabel" x:Name="DomainsLabelText" Grid.Row="1" Text="Local domains" Padding="0,8" FontWeight="SemiBold" />
                            <TextBlock x:Name="DomainsStatusText" Grid.Row="1" Grid.Column="1" Padding="0,8" />
                            <TextBlock x:Name="DomainsDetailText" Grid.Row="1" Grid.Column="2" Padding="0,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="DashboardCertificateLabel" x:Name="CertificateLabelText" Grid.Row="2" Text="HTTPS certificate" Padding="0,8" FontWeight="SemiBold" />
                            <TextBlock x:Name="CertificateStatusText" Grid.Row="2" Grid.Column="1" Padding="0,8" />
                            <TextBlock x:Name="CertificateDetailText" Grid.Row="2" Grid.Column="2" Padding="0,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="DashboardRecentActivityTitle" Text="Recent activity" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid x:Name="RecentActivityGrid" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="DashboardRecentMailTitle" Text="Mail" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button x:Uid="DashboardOpenMailButton" Grid.Column="1" Content="View all" Click="OpenMail_Click" />
                                </Grid>
                                <StackPanel x:Name="RecentMailItems" Spacing="9" />
                            </StackPanel>
                            <StackPanel x:Name="RecentDumpsPanel" Grid.Column="1" Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="DashboardRecentDumpsTitle" Text="Dumps" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button x:Uid="DashboardOpenDumpsButton" Grid.Column="1" Content="View all" Click="OpenDumps_Click" />
                                </Grid>
                                <StackPanel x:Name="RecentDumpItems" Spacing="9" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
