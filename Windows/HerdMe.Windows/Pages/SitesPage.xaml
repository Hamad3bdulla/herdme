<Page
    x:Class="HerdMe.Windows.Pages.SitesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HerdMe.Windows.Models"
    Loaded="Page_Loaded">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sites" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="EnvironmentStatusText" Text="Stopped" FontWeight="SemiBold" />
                    <TextBlock x:Name="EnvironmentEndpointText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="CreateLaravelButton" Click="CreateLaravel_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="Create Laravel" />
                    </StackPanel>
                </Button>
                <Button x:Name="EnvironmentButton" Click="Environment_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon x:Name="EnvironmentButtonIcon" Symbol="Play" />
                        <TextBlock x:Name="EnvironmentButtonText" Text="Start all" />
                    </StackPanel>
                </Button>
                <TextBox x:Name="TldTextBox" Width="104" Header="Domain" Text="test" />
                <Button VerticalAlignment="Bottom" Click="Scan_Click" ToolTipService.ToolTip="Refresh sites">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </StackPanel>
        </Grid>

        <Expander Grid.Row="1" Header="Site folders and linked projects">
            <Grid Padding="0,12,0,4" ColumnSpacing="8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RootPathTextBox" PlaceholderText="Site folder" />
                <Button Grid.Column="1" Click="Browse_Click" ToolTipService.ToolTip="Choose folder">
                    <SymbolIcon Symbol="Folder" />
                </Button>
                <Button Grid.Column="2" Click="AddRoot_Click" ToolTipService.ToolTip="Add folder">
                    <SymbolIcon Symbol="Add" />
                </Button>
                <Button Grid.Column="3" Click="RemoveRoot_Click" ToolTipService.ToolTip="Remove selected folder">
                    <SymbolIcon Symbol="Remove" />
                </Button>
                <Button Grid.Column="4" Click="LinkSite_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Link" />
                        <TextBlock Text="Link project" />
                    </StackPanel>
                </Button>
                <ListView
                    x:Name="RootList"
                    Grid.Row="1"
                    Grid.ColumnSpan="5"
                    MaxHeight="88"
                    ItemsSource="{x:Bind Roots}" />
            </Grid>
        </Expander>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="SearchBox"
                        PlaceholderText="Search sites"
                        TextChanged="SearchBox_TextChanged" />
                    <ListView
                        x:Name="SiteList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind VisibleSites}"
                        SelectionChanged="SiteList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SiteRecord">
                                <StackPanel Padding="6" Spacing="2">
                                    <TextBlock Text="{x:Bind Domain}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Framework}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <TextBlock x:Name="SiteCountText" Text="0 sites" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressRing x:Name="ScanProgress" Width="18" Height="18" />
                    </StackPanel>
                    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <SymbolIcon Symbol="Folder" FontSize="36" />
                        <TextBlock Text="No sites found" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <StackPanel x:Name="NoSelectionState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <SymbolIcon Symbol="Globe" FontSize="42" />
                        <TextBlock Text="Select a site" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>

                    <ScrollViewer x:Name="SiteDetail" Visibility="Collapsed">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SiteNameText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DomainText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Click="OpenSite_Click" ToolTipService.ToolTip="Open in browser">
                                        <SymbolIcon Symbol="Globe" />
                                    </Button>
                                    <Button Click="OpenFolder_Click" ToolTipService.ToolTip="Open project folder">
                                        <SymbolIcon Symbol="Folder" />
                                    </Button>
                                    <Button Click="OpenTerminal_Click" ToolTipService.ToolTip="Open terminal">
                                        <SymbolIcon Symbol="OpenFile" />
                                    </Button>
                                    <Button Click="EditRuntimes_Click" ToolTipService.ToolTip="Configure PHP and Node.js">
                                        <SymbolIcon Symbol="Setting" />
                                    </Button>
                                    <Button x:Name="UnlinkButton" Click="UnlinkSelectedSite_Click" ToolTipService.ToolTip="Unlink project">
                                        <SymbolIcon Symbol="Remove" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Live preview" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="PreviewToggle" Grid.Column="1" IsOn="True" Toggled="PreviewToggle_Toggled" />
                            </Grid>
                            <Border x:Name="PreviewBorder" Height="210" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                <WebView2
                                    x:Name="SitePreview"
                                    NavigationCompleted="SitePreview_NavigationCompleted"
                                    SizeChanged="SitePreview_SizeChanged" />
                            </Border>

                            <Grid ColumnSpacing="12" RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Framework" Padding="0,10" FontWeight="SemiBold" />
                                <TextBlock x:Name="FrameworkText" Grid.Column="1" Padding="0,10" />
                                <TextBlock Grid.Row="1" Text="Runtime" Padding="0,10" FontWeight="SemiBold" />
                                <TextBlock x:Name="RuntimeText" Grid.Row="1" Grid.Column="1" Padding="0,10" />
                                <TextBlock Grid.Row="2" Text="Registration" Padding="0,10" FontWeight="SemiBold" />
                                <TextBlock x:Name="RegistrationText" Grid.Row="2" Grid.Column="1" Padding="0,10" />
                                <TextBlock Grid.Row="3" Text="Path" Padding="0,10" FontWeight="SemiBold" />
                                <TextBlock x:Name="PathText" Grid.Row="3" Grid.Column="1" Padding="0,10" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Grid.Row="4" Text="URL" Padding="0,10" FontWeight="SemiBold" />
                                <HyperlinkButton x:Name="UrlButton" Grid.Row="4" Grid.Column="1" Padding="0,10" Click="OpenSite_Click" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
