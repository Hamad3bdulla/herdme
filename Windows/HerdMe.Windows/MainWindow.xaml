<Window
    x:Class="HerdMe.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:HerdMe.Windows.Views"
    xmlns:services="using:HerdMe.Windows.Services"
    Title="HerdMe">
    <Grid x:Name="RootLayout" Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar. The strip is a drag region except the search box and the status
             button, which MainWindow marks as pass-through (InputNonClientPointerSource). The
             system caption buttons stay, so Snap Layouts on the maximize button keep working. -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,16,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Herd-style brand corner: the logo and name sit above the sidebar. -->
            <Image Source="ms-appx:///Assets/HerdMe.png" Width="24" Height="24" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="HerdMe" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <AutoSuggestBox
                x:Name="TitleBarSearchBox"
                x:Uid="TitleBarSearchBox"
                Grid.Column="2"
                Width="360"
                MinWidth="120"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                PlaceholderText="Search pages and sites (Ctrl+K)"
                QueryIcon="Find"
                UpdateTextOnSelect="False"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="TitleBarSearch"
                TextChanged="TitleBarSearch_TextChanged"
                QuerySubmitted="TitleBarSearch_QuerySubmitted"
                LostFocus="TitleBarSearch_LostFocus"
                SizeChanged="TitleBarInteractive_SizeChanged">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="services:TitleBarSearchItem">
                        <Grid ColumnSpacing="10" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            <!-- Search stays out of the way: an icon that opens the box (or Ctrl+K). -->
            <Button
                x:Name="TitleBarSearchButton"
                x:Uid="TitleBarSearchButton"
                Grid.Column="3"
                Width="36"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Visibility="Collapsed"
                AutomationProperties.Name="Search (Ctrl+K)"
                AutomationProperties.AutomationId="TitleBarSearchButton"
                Click="TitleBarSearchButton_Click"
                SizeChanged="TitleBarInteractive_SizeChanged">
                <FontIcon Glyph="&#xE721;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button
                x:Name="TitleBarStatusButton"
                Grid.Column="4"
                Padding="0"
                MinWidth="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="TitleBarStatusButton"
                SizeChanged="TitleBarInteractive_SizeChanged">
                <Border x:Name="TitleBarStatus" Style="{StaticResource StatusPillNeutralStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse x:Name="TitleBarStatusDot" Style="{StaticResource StatusDotNeutralStyle}" />
                        <TextBlock x:Name="TitleBarStatusText" FontSize="12" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="TitleBarStatusMenu_Opening">
                        <MenuFlyoutItem x:Name="TitleBarStartAllItem" x:Uid="TitleBarStartAll" Text="Start all" Click="TitleBarStartAll_Click">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Play" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="TitleBarStopAllItem" x:Uid="TitleBarStopAll" Text="Stop all" Click="TitleBarStopAll_Click">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Stop" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="TitleBarOpenDashboard" Text="Open dashboard" Click="TitleBarOpenDashboard_Click">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Home" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button
                x:Name="TitleBarBellButton"
                Grid.Column="5"
                Width="36"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="TitleBarBell"
                SizeChanged="TitleBarInteractive_SizeChanged">
                <Grid>
                    <FontIcon Glyph="&#xEA8F;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <InfoBadge
                        x:Name="TitleBarBellBadge"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-4,-6,0"
                        Visibility="Collapsed" />
                </Grid>
                <Button.Flyout>
                    <Flyout x:Name="TitleBarBellFlyout" Placement="BottomEdgeAlignedRight" Opening="TitleBarBellFlyout_Opening" Closed="TitleBarBellFlyout_Closed">
                        <Grid Width="360" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="TitleBarBellHeader" Text="Notifications" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <HyperlinkButton x:Name="TitleBarBellMarkRead" x:Uid="TitleBarBellMarkRead" Grid.Column="1" Content="Mark all read" AutomationProperties.AutomationId="TitleBarBellMarkRead" Click="TitleBarBellMarkRead_Click" />
                                <HyperlinkButton x:Name="TitleBarBellClear" x:Uid="TitleBarBellClear" Grid.Column="2" Content="Clear" AutomationProperties.AutomationId="TitleBarBellClear" Click="TitleBarBellClear_Click" />
                            </Grid>
                            <TextBlock
                                x:Name="TitleBarBellEmpty"
                                x:Uid="TitleBarBellEmpty"
                                Grid.Row="1"
                                Text="Nothing yet. When a service, worker or public link stops unexpectedly, it is listed here, even if HerdMe was in the tray."
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextStyle}"
                                Visibility="Collapsed" />
                            <ScrollViewer x:Name="TitleBarBellScroller" Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="TitleBarBellList" Spacing="2" AutomationProperties.AutomationId="TitleBarBellList" />
                            </ScrollViewer>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            AutomationProperties.AutomationId="NavigationRoot"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="220"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1100"
            PaneDisplayMode="Auto"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="NavDashboard" AutomationProperties.AutomationId="NavDashboard" Content="Dashboard" Tag="dashboard">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge><InfoBadge x:Name="DashboardBadge" Style="{StaticResource CautionValueInfoBadgeStyle}" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavSites" AutomationProperties.AutomationId="NavSites" Content="Sites" Tag="sites">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavPhp" AutomationProperties.AutomationId="NavPhp" Content="PHP" Tag="php">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavNode" AutomationProperties.AutomationId="NavNode" Content="Node" Tag="node">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavServices" AutomationProperties.AutomationId="NavServices" Content="Services" Tag="services">
                <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavMail" AutomationProperties.AutomationId="NavMail" Content="Mail" Tag="mail">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Mail" /></NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge><InfoBadge x:Name="MailBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavDumps" AutomationProperties.AutomationId="NavDumps" Content="Dumps" Tag="dumps">
                <NavigationViewItem.Icon><SymbolIcon Symbol="View" /></NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge><InfoBadge x:Name="DumpsBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavDebugger" AutomationProperties.AutomationId="NavDebugger" Content="Debugger" Tag="debugger">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavLogs" AutomationProperties.AutomationId="NavLogs" Content="Logs" Tag="logs">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge><InfoBadge x:Name="LogsBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Uid="NavGeneral" AutomationProperties.AutomationId="NavGeneral" Content="General" Tag="general">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavUpdates" AutomationProperties.AutomationId="NavUpdates" Content="Updates" Tag="updates">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge><InfoBadge x:Name="UpdatesBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavAbout" AutomationProperties.AutomationId="NavAbout" Content="About" Tag="about">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <!-- NavigationView draws the raised content layer with a rounded leading corner over Mica. -->
            <ScrollViewer x:Name="WorkspaceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Frame x:Name="ContentFrame" Width="{Binding ViewportWidth, ElementName=WorkspaceScroll}" MinWidth="740" />
            </ScrollViewer>
        </NavigationView>
        <views:OnboardingView
            x:Name="Onboarding"
            Grid.Row="1"
            SetupCompleted="Onboarding_SetupCompleted" />

        <!-- One "in progress" bar for every long operation (PHP, Node, services, Composer):
             what is running, percent when the size is known, Details and one Cancel. -->
        <Border
            x:Name="OperationsBar"
            Grid.Row="2"
            Padding="16,6,12,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="OperationsBar">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="OperationsBarText"
                    MaxWidth="420"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    Style="{StaticResource CaptionTextStyle}"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.AutomationId="OperationsBarText" />
                <ProgressBar
                    x:Uid="OperationsBarProgress"
                    x:Name="OperationsBarProgress"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="100"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Progress"
                    AutomationProperties.AutomationId="OperationsBarProgress" />
                <TextBlock
                    x:Name="OperationsBarPercent"
                    Grid.Column="2"
                    MinWidth="36"
                    VerticalAlignment="Center"
                    TextAlignment="Right"
                    Style="{StaticResource CaptionTextStyle}" />
                <HyperlinkButton
                    x:Uid="OperationsBarDetails"
                    Grid.Column="3"
                    Padding="6,2,6,2"
                    Content="Details"
                    Click="StatusBarDownloads_Click"
                    AutomationProperties.AutomationId="OperationsBarDetails" />
                <Button
                    x:Uid="OperationsBarCancel"
                    x:Name="OperationsBarCancel"
                    Grid.Column="4"
                    Padding="10,3,10,4"
                    Content="Cancel"
                    Click="OperationsBarCancel_Click"
                    AutomationProperties.AutomationId="OperationsBarCancel" />
            </Grid>
        </Border>

        <!-- Status bar: environment, ports, running downloads and the loopback-only promise. -->
        <Border
            x:Name="StatusBar"
            Grid.Row="3"
            Padding="16,3,16,4"
            MinHeight="28"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource ShellBackgroundBrush}"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="StatusBar">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusBarDot" Style="{StaticResource StatusDotNeutralStyle}" />
                    <TextBlock x:Name="StatusBarEnvironmentText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StatusBarPortsText" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <HyperlinkButton
                    x:Uid="StatusBarDownloadsButton"
                    x:Name="StatusBarDownloadsButton"
                    Grid.Column="2"
                    Padding="6,0,6,0"
                    MinHeight="0"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Open downloads"
                    AutomationProperties.AutomationId="StatusBarDownloads"
                    Click="StatusBarDownloads_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ProgressRing x:Name="StatusBarDownloadsRing" Width="12" Height="12" MinWidth="12" MinHeight="12" IsActive="False" />
                        <TextBlock x:Name="StatusBarDownloadsText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </HyperlinkButton>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="StatusBarLoopback" Text="Local only" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToolTipService.ToolTip>
                        <ToolTip><TextBlock x:Uid="StatusBarLoopbackTooltip" Text="HerdMe listens on 127.0.0.1 only. Nothing is reachable from other devices unless you share a site." TextWrapping="Wrap" /></ToolTip>
                    </ToolTipService.ToolTip>
                </StackPanel>
            </Grid>
        </Border>
        <TeachingTip
            x:Name="StatusBarTip"
            x:Uid="StatusBarTip"
            Grid.Row="3"
            Target="{x:Bind StatusBar}"
            PreferredPlacement="Top"
            Title="The status bar"
            Subtitle="Environment state, the ports in use and running downloads stay visible here on every page. Select the downloads to see their progress."
            AutomationProperties.AutomationId="StatusBarTip" />

        <!-- One light confirmation surface ("Copied", "Saved", Undo) for the whole window. -->
        <Border
            x:Name="ToastHost"
            Grid.RowSpan="2"
            Margin="0,0,0,28"
            Padding="16,10,10,10"
            MinHeight="44"
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="ToastHost">
            <Border.OpacityTransition>
                <ScalarTransition />
            </Border.OpacityTransition>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock
                    x:Name="ToastText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="ToastActionButton" Grid.Column="2" Visibility="Collapsed" Click="ToastAction_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
