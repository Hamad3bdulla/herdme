<Window
    x:Class="HerdMe.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:HerdMe.Windows.Views"
    Title="HerdMe">
    <Grid x:Name="RootLayout" Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar; the whole strip stays a drag region, so it holds no controls. -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,16,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/HerdMe.png" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="HerdMe" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border
                x:Name="TitleBarStatus"
                Grid.Column="3"
                Style="{StaticResource StatusPillNeutralStyle}"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse x:Name="TitleBarStatusDot" Style="{StaticResource StatusDotNeutralStyle}" />
                    <TextBlock x:Name="TitleBarStatusText" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            AutomationProperties.AutomationId="NavigationRoot"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="220"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1100"
            PaneDisplayMode="Auto"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="NavDashboard" AutomationProperties.AutomationId="NavDashboard" Content="Dashboard" Tag="dashboard">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge><InfoBadge x:Name="DashboardBadge" Style="{StaticResource CautionValueInfoBadgeStyle}" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavSites" AutomationProperties.AutomationId="NavSites" Content="Sites" Tag="sites">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemHeader x:Uid="NavEnvironmentGroup" Content="Environment" />
            <NavigationViewItem x:Uid="NavPhp" AutomationProperties.AutomationId="NavPhp" Content="PHP" Tag="php">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavNode" AutomationProperties.AutomationId="NavNode" Content="Node" Tag="node">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavServices" AutomationProperties.AutomationId="NavServices" Content="Services" Tag="services">
                <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemHeader x:Uid="NavToolsGroup" Content="Tools" />
            <NavigationViewItem x:Uid="NavMail" AutomationProperties.AutomationId="NavMail" Content="Mail" Tag="mail">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Mail" /></NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge><InfoBadge x:Name="MailBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavDumps" AutomationProperties.AutomationId="NavDumps" Content="Dumps" Tag="dumps">
                <NavigationViewItem.Icon><SymbolIcon Symbol="View" /></NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge><InfoBadge x:Name="DumpsBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavDebugger" AutomationProperties.AutomationId="NavDebugger" Content="Debugger" Tag="debugger">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavTinker" AutomationProperties.AutomationId="NavTinker" Content="Tinker" Tag="tinker">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE756;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavLogs" AutomationProperties.AutomationId="NavLogs" Content="Logs" Tag="logs">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge><InfoBadge x:Name="LogsBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Uid="NavGeneral" AutomationProperties.AutomationId="NavGeneral" Content="General" Tag="general">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavUpdates" AutomationProperties.AutomationId="NavUpdates" Content="Updates" Tag="updates">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavAbout" AutomationProperties.AutomationId="NavAbout" Content="About" Tag="about">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <!-- NavigationView draws the raised content layer with a rounded leading corner over Mica. -->
            <ScrollViewer x:Name="WorkspaceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Frame x:Name="ContentFrame" Width="{Binding ViewportWidth, ElementName=WorkspaceScroll}" MinWidth="740" />
            </ScrollViewer>
        </NavigationView>
        <views:OnboardingView
            x:Name="Onboarding"
            Grid.Row="1"
            SetupCompleted="Onboarding_SetupCompleted" />

        <!-- Status bar: environment, ports, running downloads and the loopback-only promise. -->
        <Border
            x:Name="StatusBar"
            Grid.Row="2"
            Padding="16,3,16,4"
            MinHeight="28"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource ShellBackgroundBrush}"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="StatusBar">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusBarDot" Style="{StaticResource StatusDotNeutralStyle}" />
                    <TextBlock x:Name="StatusBarEnvironmentText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StatusBarPortsText" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <HyperlinkButton
                    x:Uid="StatusBarDownloadsButton"
                    x:Name="StatusBarDownloadsButton"
                    Grid.Column="2"
                    Padding="6,0,6,0"
                    MinHeight="0"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Open downloads"
                    AutomationProperties.AutomationId="StatusBarDownloads"
                    Click="StatusBarDownloads_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ProgressRing x:Name="StatusBarDownloadsRing" Width="12" Height="12" MinWidth="12" MinHeight="12" IsActive="False" />
                        <TextBlock x:Name="StatusBarDownloadsText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </HyperlinkButton>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="StatusBarLoopback" Text="Local only" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToolTipService.ToolTip>
                        <ToolTip><TextBlock x:Uid="StatusBarLoopbackTooltip" Text="HerdMe listens on 127.0.0.1 only. Nothing is reachable from other devices unless you share a site." TextWrapping="Wrap" /></ToolTip>
                    </ToolTipService.ToolTip>
                </StackPanel>
            </Grid>
        </Border>
        <TeachingTip
            x:Name="StatusBarTip"
            x:Uid="StatusBarTip"
            Grid.Row="2"
            Target="{x:Bind StatusBar}"
            PreferredPlacement="Top"
            Title="The status bar"
            Subtitle="Environment state, the ports in use and running downloads stay visible here on every page. Select the downloads to see their progress."
            AutomationProperties.AutomationId="StatusBarTip" />

        <!-- One light confirmation surface ("Copied", "Saved", Undo) for the whole window. -->
        <Border
            x:Name="ToastHost"
            Grid.RowSpan="2"
            Margin="0,0,0,28"
            Padding="16,10,10,10"
            MinHeight="44"
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="ToastHost">
            <Border.OpacityTransition>
                <ScalarTransition />
            </Border.OpacityTransition>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock
                    x:Name="ToastText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="ToastActionButton" Grid.Column="2" Visibility="Collapsed" Click="ToastAction_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
