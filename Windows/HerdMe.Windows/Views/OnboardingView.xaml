<UserControl
    x:Class="HerdMe.Windows.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="7" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalContentAlignment="Center"
            VerticalScrollBarVisibility="Auto">
        <Grid Padding="32,20">
            <StackPanel
                x:Name="WelcomePanel"
                AutomationProperties.AutomationId="OnboardingWelcomePanel"
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <Border
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    Background="#FFED1F2B"
                    CornerRadius="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="34"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="H" />
                </Border>
                <TextBlock
                    x:Uid="OnboardingWelcomeTitle"
                    HorizontalAlignment="Center"
                    FontSize="32"
                    FontWeight="Bold"
                    Text="Welcome to HerdMe"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Uid="OnboardingWelcomeDescription"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="HerdMe needs to prepare the local development environment. Windows will ask for administrator approval."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SetupSummaryText"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text=""
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.AutomationId="OnboardingStartButton"
                    HorizontalAlignment="Center"
                    MinWidth="168"
                    Padding="20,9"
                    Background="#FFED1F2B"
                    Click="Start_Click"
                    CornerRadius="6"
                    Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="OnboardingSetupButton" Text="Set up HerdMe" />
                        <FontIcon FontSize="13" Glyph="&#xE72A;" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel
                x:Name="ProgressPanel"
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18"
                Visibility="Collapsed">
                <ProgressRing
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Foreground="#FFED1F2B"
                    IsActive="True" />
                <TextBlock
                    x:Name="StageTitleText"
                    HorizontalAlignment="Center"
                    FontSize="26"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StageDetailText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ProgressBar
                    x:Name="SetupProgress"
                    Width="320"
                    Height="4"
                    HorizontalAlignment="Center"
                    Foreground="#FFED1F2B"
                    Maximum="100" />
                <TextBlock
                    x:Name="StepText"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel
                x:Name="FailurePanel"
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Foreground="#FFED1F2B"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    x:Uid="OnboardingFailureTitle"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Text="Setup could not finish" />
                <TextBlock
                    x:Name="FailureText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Expander
                    x:Name="FailureDetailsExpander"
                    x:Uid="OnboardingFailureDetails"
                    HorizontalAlignment="Stretch"
                    Header="Technical Details"
                    IsExpanded="False">
                    <StackPanel Spacing="8">
                        <TextBox
                            x:Name="FailureDetailsText"
                            MaxHeight="140"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            FontSize="12"
                            IsReadOnly="True"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap" />
                        <Button
                            x:Uid="OnboardingCopyFailureDetailsButton"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Copy Technical Details"
                            Click="CopyFailureDetails_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip>
                                    <TextBlock
                                        x:Uid="OnboardingCopyFailureDetailsTooltip"
                                        Text="Copy Technical Details" />
                                </ToolTip>
                            </ToolTipService.ToolTip>
                            <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                        </Button>
                    </StackPanel>
                </Expander>
                <Button
                    HorizontalAlignment="Center"
                    Padding="20,9"
                    Background="#FFED1F2B"
                    Click="Start_Click"
                    CornerRadius="6"
                    Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="OnboardingTryAgainButton" Text="Try Again" />
                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel
                x:Name="CompletedPanel"
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="54"
                    Foreground="#FF188038"
                    Glyph="&#xE73E;" />
                <TextBlock
                    x:Uid="OnboardingCompletedTitle"
                    HorizontalAlignment="Center"
                    FontSize="32"
                    FontWeight="Bold"
                    Text="HerdMe is ready" />
                <TextBlock
                    x:Uid="OnboardingCompletedDescription"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The default local development environment has been installed successfully."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Padding="20,9"
                    Background="#FFED1F2B"
                    Click="Continue_Click"
                    CornerRadius="6"
                    Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="OnboardingOpenButton" Text="Open HerdMe" />
                        <FontIcon FontSize="13" Glyph="&#xE72A;" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <Rectangle Grid.Row="1" Fill="#FFED1F2B" />
    </Grid>
</UserControl>
