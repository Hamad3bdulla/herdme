<UserControl
    x:Class="HerdMe.Windows.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="7" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="48">
            <StackPanel
                x:Name="WelcomePanel"
                MaxWidth="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
                <Border
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    Background="#FFED1F2B"
                    CornerRadius="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="38"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="H" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="36"
                    FontWeight="Bold"
                    Text="Welcome to HerdMe" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="HerdMe needs to prepare the local development environment. Windows will ask for administrator approval."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="PHP 8.4  |  Composer  |  Laravel Installer  |  Node.js 22  |  HTTPS" />
                <Button
                    HorizontalAlignment="Center"
                    Padding="20,9"
                    Background="#FFED1F2B"
                    Click="Start_Click"
                    CornerRadius="6"
                    Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Set up HerdMe" />
                        <FontIcon FontSize="13" Glyph="&#xE72A;" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel
                x:Name="ProgressPanel"
                MaxWidth="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18"
                Visibility="Collapsed">
                <ProgressRing
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Foreground="#FFED1F2B"
                    IsActive="True" />
                <TextBlock
                    x:Name="StageTitleText"
                    HorizontalAlignment="Center"
                    FontSize="26"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StageDetailText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ProgressBar
                    x:Name="SetupProgress"
                    Width="320"
                    Height="4"
                    HorizontalAlignment="Center"
                    Foreground="#FFED1F2B"
                    Maximum="100" />
                <TextBlock
                    x:Name="StepText"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel
                x:Name="FailurePanel"
                MaxWidth="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Foreground="#FFED1F2B"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Text="Setup could not finish" />
                <TextBlock
                    x:Name="FailureText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Padding="20,9"
                    Background="#FFED1F2B"
                    Click="Start_Click"
                    CornerRadius="6"
                    Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Try Again" />
                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel
                x:Name="CompletedPanel"
                MaxWidth="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="54"
                    Foreground="#FF188038"
                    Glyph="&#xE73E;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="32"
                    FontWeight="Bold"
                    Text="HerdMe is ready" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The default local development environment has been installed successfully."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Padding="20,9"
                    Background="#FFED1F2B"
                    Click="Continue_Click"
                    CornerRadius="6"
                    Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Open HerdMe" />
                        <FontIcon FontSize="13" Glyph="&#xE72A;" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Rectangle Grid.Row="1" Fill="#FFED1F2B" />
    </Grid>
</UserControl>
