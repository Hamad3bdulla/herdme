<UserControl
    x:Class="HerdMe.Windows.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Transparent so the window backdrop (Mica or the shell brush) shows through. -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="7" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalContentAlignment="Center"
            VerticalScrollBarVisibility="Auto">
        <Grid Padding="32,20">
            <StackPanel
                x:Name="WelcomePanel"
                AutomationProperties.AutomationId="OnboardingWelcomePanel"
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <Image Source="ms-appx:///Assets/HerdMe.png" Width="72" Height="72" HorizontalAlignment="Center" />
                <TextBlock
                    x:Uid="OnboardingWelcomeTitle"
                    HorizontalAlignment="Center"
                    FontSize="32"
                    FontWeight="Bold"
                    Text="Welcome to HerdMe"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Uid="OnboardingWelcomeDescription"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="HerdMe needs to prepare the local development environment. Windows will ask for administrator approval."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SetupSummaryText"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text=""
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.AutomationId="OnboardingStartButton"
                    HorizontalAlignment="Center"
                    MinWidth="168"
                    Padding="20,9"
                    Click="Start_Click"
                    CornerRadius="6"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="OnboardingSetupButton" Text="Set up HerdMe" />
                        <FontIcon FontSize="13" Glyph="&#xE72A;" MirroredWhenRightToLeft="True" />
                    </StackPanel>
                </Button>
                <HyperlinkButton
                    x:Uid="OnboardingLearnMoreButton"
                    AutomationProperties.AutomationId="OnboardingLearnMoreButton"
                    HorizontalAlignment="Center"
                    Click="LearnMore_Click"
                    Content="What will setup change?" />
            </StackPanel>

            <!-- Step 2 (optional): what setup changes on this PC and why Windows asks for approval. -->
            <StackPanel
                x:Name="ExplainPanel"
                AutomationProperties.AutomationId="OnboardingExplainPanel"
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Visibility="Collapsed">
                <TextBlock
                    x:Uid="OnboardingExplainTitle"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Text="What setup will do"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Border Padding="18,16" Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Top" Margin="0,2,0,0" FontSize="20" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE774;" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="OnboardingExplainDomainsTitle" FontWeight="SemiBold" Text="Local .test domains" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="OnboardingExplainDomainsText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="HerdMe adds one marked block to the Windows hosts file so https://name.test/ opens your projects. Only administrators can change that file, which is why Windows asks for approval."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Top" Margin="0,2,0,0" FontSize="20" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE72E;" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="OnboardingExplainCertificateTitle" FontWeight="SemiBold" Text="Local HTTPS certificate" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="OnboardingExplainCertificateText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="HerdMe creates a certificate authority on this PC and trusts it for your Windows account only, so browsers accept your local sites. Windows asks you to confirm it once."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Top" Margin="0,2,0,0" FontSize="20" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE896;" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="OnboardingExplainRuntimesTitle" FontWeight="SemiBold" Text="PHP and developer tools" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="ExplainRuntimesText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Top" Margin="0,2,0,0" FontSize="20" Foreground="{ThemeResource BrandBrush}" Glyph="&#xE8A7;" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="OnboardingExplainPrivacyTitle" FontWeight="SemiBold" Text="Stays on this PC" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="OnboardingExplainPrivacyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Every HerdMe service listens on this PC only. Nothing is shared until you share a site yourself."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <Button Padding="16,9" Click="Back_Click" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE72B;" MirroredWhenRightToLeft="True" />
                            <TextBlock x:Uid="OnboardingBackButton" Text="Back" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.AutomationId="OnboardingExplainStartButton"
                        MinWidth="168"
                        Padding="20,9"
                        Click="Start_Click"
                        CornerRadius="6"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="OnboardingExplainSetupButton" Text="Set up HerdMe" />
                            <FontIcon FontSize="13" Glyph="&#xE72A;" MirroredWhenRightToLeft="True" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel
                x:Name="ProgressPanel"
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18"
                Visibility="Collapsed">
                <ProgressRing
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource BrandBrush}"
                    IsActive="True" />
                <TextBlock
                    x:Name="StageTitleText"
                    HorizontalAlignment="Center"
                    FontSize="26"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StageDetailText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ProgressBar
                    x:Name="SetupProgress"
                    Width="320"
                    Height="4"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource BrandBrush}"
                    Maximum="100" />
                <TextBlock
                    x:Name="StepText"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel
                x:Name="FailurePanel"
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    x:Uid="OnboardingFailureTitle"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Text="Setup could not finish" />
                <TextBlock
                    x:Name="FailureText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Expander
                    x:Name="FailureDetailsExpander"
                    x:Uid="OnboardingFailureDetails"
                    HorizontalAlignment="Stretch"
                    Header="Technical Details"
                    IsExpanded="False">
                    <StackPanel Spacing="8">
                        <TextBox
                            x:Name="FailureDetailsText"
                            MaxHeight="140"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            FontSize="12"
                            IsReadOnly="True"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap" />
                        <Button
                            x:Uid="OnboardingCopyFailureDetailsButton"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Copy Technical Details"
                            Click="CopyFailureDetails_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip>
                                    <TextBlock
                                        x:Uid="OnboardingCopyFailureDetailsTooltip"
                                        Text="Copy Technical Details" />
                                </ToolTip>
                            </ToolTipService.ToolTip>
                            <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                        </Button>
                    </StackPanel>
                </Expander>
                <Button
                    HorizontalAlignment="Center"
                    Padding="20,9"
                    Click="Start_Click"
                    CornerRadius="6"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="OnboardingTryAgainButton" Text="Try Again" />
                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel
                x:Name="CompletedPanel"
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="54"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE73E;" />
                <TextBlock
                    x:Uid="OnboardingCompletedTitle"
                    HorizontalAlignment="Center"
                    FontSize="32"
                    FontWeight="Bold"
                    Text="HerdMe is ready" />
                <TextBlock
                    x:Uid="OnboardingCompletedDescription"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The default local development environment has been installed successfully."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Uid="OnboardingNextStepsTitle"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Start with a project"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <Button
                        AutomationProperties.AutomationId="OnboardingCreateLaravelButton"
                        Padding="16,9"
                        Click="CreateLaravel_Click"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE710;" />
                            <TextBlock x:Uid="OnboardingCreateLaravelButton" Text="Create a Laravel project" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.AutomationId="OnboardingParkFolderButton"
                        Padding="16,9"
                        Click="ParkFolder_Click"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                            <TextBlock x:Uid="OnboardingParkFolderButton" Text="Park a folder" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button
                    HorizontalAlignment="Center"
                    Padding="20,9"
                    Click="Continue_Click"
                    CornerRadius="6"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="OnboardingOpenButton" Text="Open HerdMe" />
                        <FontIcon FontSize="13" Glyph="&#xE72A;" MirroredWhenRightToLeft="True" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <Rectangle Grid.Row="1" Fill="{ThemeResource BrandBrush}" />
    </Grid>
</UserControl>
