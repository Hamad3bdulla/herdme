<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#F4F5F7" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F7F8FA" />
            <SolidColorBrush x:Key="BrandBrush" Color="#C92B3D" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#C92B3D" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#B62435" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#9D2030" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SitesTintBrush" Color="#FCEDEF" />
            <SolidColorBrush x:Key="ServicesTintBrush" Color="#E7F5F0" />
            <SolidColorBrush x:Key="MailTintBrush" Color="#EAF1FC" />
            <SolidColorBrush x:Key="DumpsTintBrush" Color="#FFF3DB" />
            <SolidColorBrush x:Key="ServicesInkBrush" Color="#13765D" />
            <SolidColorBrush x:Key="MailInkBrush" Color="#315EAD" />
            <SolidColorBrush x:Key="DumpsInkBrush" Color="#956300" />
            <SolidColorBrush x:Key="FrameworkLaravelTintBrush" Color="#FDE8E6" />
            <SolidColorBrush x:Key="FrameworkLaravelInkBrush" Color="#C7291C" />
            <SolidColorBrush x:Key="FrameworkWordPressTintBrush" Color="#E3EFF7" />
            <SolidColorBrush x:Key="FrameworkWordPressInkBrush" Color="#1D5F8A" />
            <SolidColorBrush x:Key="FrameworkPhpTintBrush" Color="#ECEAF7" />
            <SolidColorBrush x:Key="FrameworkPhpInkBrush" Color="#4F4B93" />
            <SolidColorBrush x:Key="FrameworkNodeTintBrush" Color="#E6F4E4" />
            <SolidColorBrush x:Key="FrameworkNodeInkBrush" Color="#2F7A2A" />
            <SolidColorBrush x:Key="SkeletonBrush" Color="#E8EAED" />
            <SolidColorBrush x:Key="DangerFillBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="DangerOnFillBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DangerInkBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="DangerBorderBrush" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#202124" />
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#191A1D" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#282A2E" />
            <SolidColorBrush x:Key="BrandBrush" Color="#FF8794" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF8794" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF9DA7" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#E87887" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#202124" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#202124" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#202124" />
            <SolidColorBrush x:Key="SitesTintBrush" Color="#42292F" />
            <SolidColorBrush x:Key="ServicesTintBrush" Color="#203C34" />
            <SolidColorBrush x:Key="MailTintBrush" Color="#27364C" />
            <SolidColorBrush x:Key="DumpsTintBrush" Color="#403824" />
            <SolidColorBrush x:Key="ServicesInkBrush" Color="#78D9B3" />
            <SolidColorBrush x:Key="MailInkBrush" Color="#97BEFF" />
            <SolidColorBrush x:Key="DumpsInkBrush" Color="#F3CE7C" />
            <SolidColorBrush x:Key="FrameworkLaravelTintBrush" Color="#4A2522" />
            <SolidColorBrush x:Key="FrameworkLaravelInkBrush" Color="#FF8A80" />
            <SolidColorBrush x:Key="FrameworkWordPressTintBrush" Color="#1F3445" />
            <SolidColorBrush x:Key="FrameworkWordPressInkBrush" Color="#8CC4EC" />
            <SolidColorBrush x:Key="FrameworkPhpTintBrush" Color="#2E2C47" />
            <SolidColorBrush x:Key="FrameworkPhpInkBrush" Color="#B3AEF2" />
            <SolidColorBrush x:Key="FrameworkNodeTintBrush" Color="#233A22" />
            <SolidColorBrush x:Key="FrameworkNodeInkBrush" Color="#93D98C" />
            <SolidColorBrush x:Key="SkeletonBrush" Color="#33363B" />
            <SolidColorBrush x:Key="DangerFillBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="DangerOnFillBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="DangerInkBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="DangerBorderBrush" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SitesTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ServicesTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MailTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DumpsTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ServicesInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MailInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DumpsInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FrameworkLaravelTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FrameworkLaravelInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FrameworkWordPressTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FrameworkWordPressInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FrameworkPhpTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FrameworkPhpInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FrameworkNodeTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FrameworkNodeInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SkeletonBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="DangerFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DangerOnFillBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DangerInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Thickness x:Key="PagePadding">28,24,28,24</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <Thickness x:Key="CardPadding">18,16,18,16</Thickness>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Section headers sit above a card, like Windows Settings. -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,6,2,-6" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>
    <!-- Every page section is a card; the name is kept for existing pages. -->
    <Style x:Key="SectionDividerStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}" />
    <Style x:Key="CardDividerStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="IconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="ToolPaneStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <!--
        Status visuals are applied as styles (not brushes) from code so they follow
        light/dark/high-contrast theme changes while the page stays open.
    -->
    <Style x:Key="StatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorNeutralBrush}" />
    </Style>
    <Style x:Key="StatusDotNeutralStyle" TargetType="Ellipse" BasedOn="{StaticResource StatusDotStyle}" />
    <Style x:Key="StatusDotSuccessStyle" TargetType="Ellipse" BasedOn="{StaticResource StatusDotStyle}">
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="StatusDotCautionStyle" TargetType="Ellipse" BasedOn="{StaticResource StatusDotStyle}">
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="StatusDotCriticalStyle" TargetType="Ellipse" BasedOn="{StaticResource StatusDotStyle}">
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,3,10,4" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatusPillNeutralStyle" TargetType="Border" BasedOn="{StaticResource StatusPillStyle}" />
    <Style x:Key="StatusPillSuccessStyle" TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
    </Style>
    <Style x:Key="StatusPillCautionStyle" TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
    </Style>
    <Style x:Key="StatusPillCriticalStyle" TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
    </Style>

    <Style x:Key="StatusGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorNeutralBrush}" />
    </Style>
    <Style x:Key="StatusGlyphNeutralStyle" TargetType="FontIcon" BasedOn="{StaticResource StatusGlyphStyle}" />
    <Style x:Key="StatusGlyphSuccessStyle" TargetType="FontIcon" BasedOn="{StaticResource StatusGlyphStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="StatusGlyphCautionStyle" TargetType="FontIcon" BasedOn="{StaticResource StatusGlyphStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="StatusGlyphCriticalStyle" TargetType="FontIcon" BasedOn="{StaticResource StatusGlyphStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
    <!-- Text colors for status lines built in code; neutral is secondary text. -->
    <Style x:Key="StatusTextPrimaryStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="StatusTextNeutralStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="StatusTextSuccessStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="StatusTextCautionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="StatusTextCriticalStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!--
        Settings rows (Windows Settings pattern): a group card holds rows separated by
        CardDividerStyle rectangles. Each row is Grid(Auto icon | * text | Auto control).
    -->
    <Style x:Key="SettingsGroupStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="SettingsRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>
    <Style x:Key="SettingsRowIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Width" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SettingsRowTextStyle" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="1" />
    </Style>
    <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SettingsRowDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SettingsRowControlStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- Read-only value rows (paths, versions) align under the row title. -->
    <Style x:Key="SettingsValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>
    <Style x:Key="PageHeaderStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="PageContentStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="{StaticResource PagePadding}" />
        <Setter Property="Spacing" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="StatusCriticalTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Field messages under inputs (InputValidation): a warning that does not block. -->
    <Style x:Key="StatusCautionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Card-looking Grid for rows that code builds and diffs in place (downloads, updates). -->
    <Style x:Key="ListCardStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>
    <!-- Sites list tiles: a tinted square with the framework monogram, tinted per framework. -->
    <Style x:Key="SiteTileLaravelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FrameworkLaravelTintBrush}" />
    </Style>
    <Style x:Key="SiteMonogramLaravelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource FrameworkLaravelInkBrush}" />
    </Style>
    <Style x:Key="SiteTileWordPressStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FrameworkWordPressTintBrush}" />
    </Style>
    <Style x:Key="SiteMonogramWordPressStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource FrameworkWordPressInkBrush}" />
    </Style>
    <Style x:Key="SiteTilePhpStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FrameworkPhpTintBrush}" />
    </Style>
    <Style x:Key="SiteMonogramPhpStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource FrameworkPhpInkBrush}" />
    </Style>
    <Style x:Key="SiteTileNodeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FrameworkNodeTintBrush}" />
    </Style>
    <Style x:Key="SiteMonogramNodeStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource FrameworkNodeInkBrush}" />
    </Style>
    <Style x:Key="SiteTileSiteStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SitesTintBrush}" />
    </Style>
    <Style x:Key="SiteMonogramSiteStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource BrandBrush}" />
    </Style>
    <!-- Placeholder blocks shown while a page loads for the first time. -->
    <Style x:Key="SkeletonBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SkeletonBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Collapsible General sections: the expander draws the card, the rows sit flush inside. -->
    <Style x:Key="GeneralSectionExpanderStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="GeneralSectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SettingsGroupInExpanderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- Full-width action tiles in the Sites Tools and Database tabs. -->
    <Style x:Key="SitesToolButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="14,8,14,8" />
    </Style>
    <Style x:Key="SitesToolDropDownStyle" TargetType="DropDownButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="14,8,14,8" />
    </Style>
    <Style x:Key="EmptyStateGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- Borderless button for secondary actions inside cards and the title bar. -->
    <Style x:Key="SubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <!--
        Destructive actions (delete, clear, stop all, move to Recycle Bin) use one red button,
        both inline and as the primary button of their confirmation dialog.
        See Views/DangerStyles.cs; the dialog default is always Cancel.
    -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="11,5,11,6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Background" Value="{ThemeResource DangerFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource DangerOnFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DangerBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        Foreground="{TemplateBinding Foreground}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        AutomationProperties.AccessibilityView="Raw">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.9" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.75" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource ControlFillColorDisabledBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Same size for icon-only toggles; a Button style cannot be applied to a ToggleButton. -->
    <Style x:Key="ToolbarIconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Icon-only and menu versions of a destructive action: same red, same confirmation. -->
    <Style x:Key="DangerToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DangerInkBrush}" />
    </Style>
    <Style x:Key="DangerMenuFlyoutItemStyle" TargetType="MenuFlyoutItem">
        <Setter Property="Foreground" Value="{ThemeResource DangerInkBrush}" />
    </Style>
    <Style TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style TargetType="NavigationViewItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
</ResourceDictionary>
