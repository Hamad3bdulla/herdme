    "Add a sites folder or create a Laravel project to get started." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أضف مجلد مواقع أو أنشئ مشروع Laravel للبدء." } } } },
    "Add or link a site before updating a .env file." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أضف موقعاً أو اربطه قبل تحديث ملف .env." } } } },
    "Add Service" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إضافة خدمة" } } } },
    "Add Site" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إضافة موقع" } } } },
    "Adding Laravel Boost as a development dependency." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إضافة Laravel Boost كتبعية للتطوير." } } } },
    "Adding the HerdMe local certificate authority to the system keychain." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إضافة سلطة شهادات HerdMe المحلية إلى سلسلة مفاتيح النظام." } } } },
    "Application updates" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تحديثات التطبيق" } } } },
    "Auto" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تلقائي" } } } },
    "Building frontend assets" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بناء ملفات الواجهة" } } } },
    "Cancel" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إلغاء" } } } },
    "Checking project details" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فحص تفاصيل المشروع" } } } },
    "Checking that Laravel finished with its required files." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التحقق من أن Laravel أنشأ الملفات المطلوبة." } } } },
    "Choose between auto, light, or dark theme." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر المظهر التلقائي أو الفاتح أو الداكن." } } } },
    "Compiling the production Vite assets used by the site." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تجميع ملفات Vite الإنتاجية التي يستخدمها الموقع." } } } },
    "Composer" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "Composer" } } } },
