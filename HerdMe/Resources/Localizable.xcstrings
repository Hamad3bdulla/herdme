{
  "sourceLanguage" : "en",
  "strings" : {
    "Cancelled" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أُلغي" } } } },
    "Cancelling" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ الإلغاء" } } } },
    "Completed" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اكتمل" } } } },
    "Failed" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فشل" } } } },
    "Failed (exit %lld)" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فشل (رمز الخروج %lld)" } } } },
    "HerdMe could not read this project's package.json file." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe قراءة ملف package.json لهذا المشروع." } } } },
    "Loading npm scripts" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ تحميل سكربتات npm" } } } },
    "Output will appear here." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ستظهر النتيجة هنا." } } } },
    "Ready" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جاهز" } } } },
    "Reload npm scripts" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إعادة تحميل سكربتات npm" } } } },
    "Run npm Script" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تشغيل سكربت npm" } } } },
    "Script" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "السكربت" } } } },
    "The npm script invocation is incomplete." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "طلب تشغيل سكربت npm غير مكتمل." } } } },
    "The npm script name is invalid." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اسم سكربت npm غير صالح." } } } },
    "The selected managed Node.js executable is unavailable." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ملف Node.js التنفيذي المُدار المحدد غير متاح." } } } },
    "The selected managed Node.js runtime does not contain npm." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بيئة Node.js المُدارة المحددة لا تحتوي على npm." } } } },
    "The selected npm script is no longer available. Reload the script list." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سكربت npm المحدد لم يعد متاحًا. أعد تحميل قائمة السكربتات." } } } },
    "Tinker is available only for Laravel projects with an artisan executable." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتوفر Tinker فقط لمشاريع Laravel التي تحتوي على ملف artisan قابل للتنفيذ." } } } },
    "This project does not contain a package.json file." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذا المشروع لا يحتوي على ملف package.json." } } } },
    "This project does not define any runnable npm scripts." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذا المشروع لا يعرّف أي سكربتات npm قابلة للتشغيل." } } } },
    "Timed out" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "انتهت المهلة" } } } },
    "npm" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "npm" } } } },
    "npm Scripts" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سكربتات npm" } } } },
    "package.json contains more than 256 npm scripts." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتوي package.json على أكثر من 256 سكربت npm." } } } },
    "package.json does not contain valid JSON." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يحتوي package.json على JSON صالح." } } } },
    "package.json must be no larger than 1 MB." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يجب ألا يتجاوز حجم package.json مقدار 1 ميغابايت." } } } },
    "Artisan commands are limited to 32 arguments." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تقتصر أوامر Artisan على 32 وسيطة." } } } },
    "Artisan commands are limited to 4 KB and 512 bytes per argument." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تقتصر أوامر Artisan على 4 كيلوبايت و512 بايت لكل وسيطة." } } } },
    "Artisan is available only for Laravel projects with an artisan executable." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتوفر Artisan فقط لمشاريع Laravel التي تحتوي على ملف artisan قابل للتنفيذ." } } } },
    "Enter an Artisan command such as route:list, without php or shell syntax." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدخل أمر Artisan مثل route:list من دون php أو صياغة shell." } } } },
    "Enter an Artisan command." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدخل أمر Artisan." } } } },
    "HerdMe can only unlink projects that were registered through a symbolic link." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يمكن لـHerdMe إلغاء ربط المشاريع المسجلة عبر رابط رمزي فقط." } } } },
    "HerdMe can only move a direct child of a configured sites folder to Trash." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يمكن لـHerdMe نقل مجلد مشروع مباشر فقط من داخل أحد مجلدات المواقع المضبوطة إلى سلة المهملات." } } } },
    "HerdMe could not generate secure certificate credentials." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe إنشاء بيانات اعتماد آمنة للشهادة." } } } },
    "HerdMe could not generate secure credentials for this service." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe إنشاء بيانات اعتماد آمنة لهذه الخدمة." } } } },
    "HerdMe could not inspect the selected PHP runtime." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe فحص بيئة PHP المحددة." } } } },
    "HerdMe could not migrate the existing %@ data to managed authentication. The data was preserved unchanged." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe ترحيل بيانات %@ الحالية إلى المصادقة المُدارة. تم الاحتفاظ بالبيانات دون تغيير." } } } },
    "HerdMe could not open the command in Terminal." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe فتح الأمر في الطرفية." } } } },
    "HerdMe could not read its certificate credentials from Keychain." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe قراءة بيانات اعتماد شهادته من سلسلة المفاتيح." } } } },
    "HerdMe could not read its settings. The original file was preserved at %@. No replacement settings were saved." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe قراءة إعداداته. تم الاحتفاظ بالملف الأصلي في %@ ولم تُحفظ إعدادات بديلة." } } } },
    "HerdMe could not read this mail message because its saved data is invalid." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe قراءة رسالة البريد لأن بياناتها المحفوظة غير صالحة." } } } },
    "HerdMe could not read this service's credentials from Keychain." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe قراءة بيانات اعتماد هذه الخدمة من سلسلة المفاتيح." } } } },
    "HerdMe could not remove this service's credentials from Keychain." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe إزالة بيانات اعتماد هذه الخدمة من سلسلة المفاتيح." } } } },
    "HerdMe could not save its certificate credentials in Keychain." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe حفظ بيانات اعتماد شهادته في سلسلة المفاتيح." } } } },
    "HerdMe could not save this service's credentials in Keychain." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe حفظ بيانات اعتماد هذه الخدمة في سلسلة المفاتيح." } } } },
    "HerdMe could not verify managed authentication for %@. The service was stopped and its data was preserved." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe التحقق من المصادقة المُدارة لـ%@. تم إيقاف الخدمة والاحتفاظ ببياناتها." } } } },
    "HerdMe did not replace settings created by a newer release (schema %1$lld). The original file was preserved at %2$@. Update HerdMe before restoring it." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم يستبدل HerdMe الإعدادات التي أنشأها إصدار أحدث (المخطط %1$lld). تم الاحتفاظ بالملف الأصلي في %2$@. حدّث HerdMe قبل استعادته." } } } },
    "HerdMe does not have .env variables for %@." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يملك HerdMe متغيرات .env للخدمة %@." } } } },
    "HerdMe does not read or modify another application's project, runtime, or data folders. Choose a HerdMe-owned folder instead." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يقرأ HerdMe ولا يعدّل مشاريع تطبيق آخر أو بيئات تشغيله أو مجلدات بياناته. اختر مجلداً يخص HerdMe بدلاً من ذلك." } } } },
    "HerdMe needs explicit Keychain approval before HTTPS can start." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتاج HerdMe إلى موافقة صريحة على سلسلة المفاتيح قبل بدء HTTPS." } } } },
    "HerdMe will not modify a symbolic .env file. Replace it with a project-owned file first." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لن يعدّل HerdMe ملف .env رمزياً. استبدله أولاً بملف يملكه المشروع." } } } },
    "Move Site to Trash?" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نقل الموقع إلى سلة المهملات؟" } } } },
    "Move HerdMe to the Applications folder and reopen it before setting up local domains." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "انقل HerdMe إلى مجلد التطبيقات ثم أعد فتحه قبل إعداد النطاقات المحلية." } } } },
    "Move “%@” to Trash?" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نقل «%@» إلى سلة المهملات؟" } } } },
    "Move to Trash" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نقل إلى سلة المهملات" } } } },
    "HerdMe's saved certificate credentials are invalid." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بيانات اعتماد شهادة HerdMe المحفوظة غير صالحة." } } } },
    "Install a HerdMe-managed PHP runtime with PHP-FPM before starting sites." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ثبّت بيئة PHP يديرها HerdMe وتتضمن PHP-FPM قبل تشغيل المواقع." } } } },
    "Malformed PHP serialized value." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "قيمة PHP المتسلسلة مشوهة." } } } },
    "Open HerdMe and start this service once to allow Keychain access." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "افتح HerdMe وشغّل هذه الخدمة مرة واحدة للسماح بالوصول إلى سلسلة المفاتيح." } } } },
    "PHP-FPM connection failed: %@" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فشل اتصال PHP-FPM: %@" } } } },
    "PHP-FPM could not be started. Check %@ for details." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر تشغيل PHP-FPM. راجع %@ للتفاصيل." } } } },
    "PHP-FPM returned an invalid response." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أعاد PHP-FPM استجابة غير صالحة." } } } },
    "The %@ runtime is missing its command-line client, so HerdMe cannot secure this database." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تفتقد بيئة %@ عميل سطر الأوامر، لذلك لا يستطيع HerdMe تأمين قاعدة البيانات هذه." } } } },
    "The Artisan command contains an unfinished quote." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتوي أمر Artisan على علامة اقتباس غير مكتملة." } } } },
    "The Artisan command contains an unsupported control character." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتوي أمر Artisan على محرف تحكم غير مدعوم." } } } },
    "The PHP serialized value exceeds HerdMe's safety limits." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تتجاوز قيمة PHP المتسلسلة حدود الأمان في HerdMe." } } } },
    "The command timed out after %lld seconds." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "انتهت مهلة الأمر بعد %lld ثانية." } } } },
    "The command was cancelled." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم إلغاء الأمر." } } } },
    "The configured %@ port is invalid." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "منفذ %@ المُعد غير صالح." } } } },
    "The downloaded archive contains a link or special file." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتوي الأرشيف المنزّل على رابط أو ملف خاص." } } } },
    "The downloaded archive contains an unsafe path." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتوي الأرشيف المنزّل على مسار غير آمن." } } } },
    "The downloaded archive contains more than %lld entries." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتوي الأرشيف المنزّل على أكثر من %lld إدخالاً." } } } },
    "The downloaded archive expands beyond the supported %lld-byte limit." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتجاوز الأرشيف بعد فكّه الحد المدعوم البالغ %lld بايت." } } } },
    "The downloaded archive has an invalid entry listing." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "قائمة إدخالات الأرشيف المنزّل غير صالحة." } } } },
    "The downloaded archive is empty." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الأرشيف المنزّل فارغ." } } } },
    "The extracted archive did not match its validated contents." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم يطابق الأرشيف المفكوك محتوياته التي تم التحقق منها." } } } },
    "The local HTTP request headers are too large." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ترويسات طلب HTTP المحلي كبيرة جداً." } } } },
    "The local HTTP request is malformed." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "طلب HTTP المحلي مشوه." } } } },
    "The local HTTP request is too large." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "طلب HTTP المحلي كبير جداً." } } } },
    "The local HTTP transfer coding is not supported." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ترميز نقل HTTP المحلي غير مدعوم." } } } },
    "The local HTTP version is not supported." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إصدار HTTP المحلي غير مدعوم." } } } },
    "The project's .env file is larger than the supported 4 MB limit." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ملف .env الخاص بالمشروع أكبر من الحد المدعوم البالغ 4 ميغابايت." } } } },
    "The project's .env file must be a regular UTF-8 text file." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يجب أن يكون ملف .env الخاص بالمشروع ملف نص UTF-8 عادياً." } } } },
    "The requested local path is invalid." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المسار المحلي المطلوب غير صالح." } } } },
    "The requested local site has no front controller." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يملك الموقع المحلي المطلوب وحدة تحكم أمامية." } } } },
    "The selected PHP runtime is missing Laravel extensions: %@." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تفتقد بيئة PHP المحددة إضافات Laravel التالية: %@." } } } },
    "The selected project directory is no longer available." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مجلد المشروع المحدد لم يعد متاحاً." } } } },
    "The selected runtime version is invalid." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إصدار بيئة التشغيل المحدد غير صالح." } } } },
    "The settings schema version %lld is invalid." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إصدار مخطط الإعدادات %lld غير صالح." } } } },
    "The settings were created by a newer HerdMe release (schema %1$lld); this release supports up to schema %2$lld." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أُنشئت الإعدادات بواسطة إصدار HerdMe أحدث (المخطط %1$lld)، بينما يدعم هذا الإصدار حتى المخطط %2$lld." } } } },
    "This mail message no longer exists." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "رسالة البريد هذه لم تعد موجودة." } } } },
    "This service's saved credentials are invalid. Delete and add the service again." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بيانات اعتماد هذه الخدمة المحفوظة غير صالحة. احذف الخدمة ثم أضفها من جديد." } } } },
    "Unsupported PHP serialized type: %@" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نوع تسلسل PHP غير مدعوم: %@" } } } },
    "%1$@ %2$@ is not installed by HerdMe." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ %2$@ غير مثبت بواسطة HerdMe." } } } },
    "%@ did not match its official checksum." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم يطابق %@ بصمته الرسمية." } } } },
    "A folder with this project name already exists." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يوجد مجلد باسم هذا المشروع بالفعل." } } } },
    "Approve HerdMe in System Settings > General > Login Items, then try local domains again." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اعتمد HerdMe في إعدادات النظام > عام > عناصر تسجيل الدخول، ثم أعد محاولة إعداد النطاقات المحلية." } } } },
    "Automatic runtime management is not available for %@ yet." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الإدارة التلقائية لبيئة تشغيل %@ غير متاحة بعد." } } } },
    "Enter a valid project name." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدخل اسماً صالحاً للمشروع." } } } },
    "Enter the custom starter kit as a Composer package such as vendor/package." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدخل حزمة البداية المخصصة كحزمة Composer مثل vendor/package." } } } },
    "HerdMe could not create its local certificate." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe إنشاء شهادته المحلية." } } } },
    "HerdMe could not find an available local development port." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe العثور على منفذ متاح للتطوير المحلي." } } } },
    "HerdMe could not load its HTTPS identity (Security status %d)." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe تحميل هوية HTTPS (حالة الأمان %d)." } } } },
    "HerdMe could not prepare valid internal ports for local domains." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على HerdMe تجهيز منافذ داخلية صالحة للنطاقات المحلية." } } } },
    "HerdMe created a certificate bundle, but it did not contain a usable identity." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أنشأ HerdMe حزمة شهادات، لكنها لا تحتوي على هوية صالحة للاستخدام." } } } },
    "HerdMe does not create projects inside another application's folders. Choose a HerdMe-owned folder instead." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا ينشئ HerdMe مشاريع داخل مجلدات تطبيق آخر. اختر مجلداً يخص HerdMe بدلاً من ذلك." } } } },
    "Homebrew is required to install PHP on macOS." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يلزم Homebrew لتثبيت PHP على macOS." } } } },
    "Homebrew is required to install local service runtimes on macOS." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يلزم Homebrew لتثبيت بيئات تشغيل الخدمات المحلية على macOS." } } } },
    "Install HerdMe PHP %@ before installing Xdebug." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ثبّت HerdMe PHP %@ قبل تثبيت Xdebug." } } } },
    "Install and activate a HerdMe-managed PHP version before starting sites." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ثبّت وفعّل إصدار PHP يديره HerdMe قبل تشغيل المواقع." } } } },
    "Install the %@ runtime before starting this service." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ثبّت بيئة تشغيل %@ قبل تشغيل هذه الخدمة." } } } },
    "Laravel Installer could not finish creating the site." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على مثبّت Laravel إكمال إنشاء الموقع." } } } },
    "Laravel Installer finished without creating a complete Laravel project. Missing: %@." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "انتهى مثبّت Laravel دون إنشاء مشروع Laravel مكتمل. المفقود: %@." } } } },
    "No %@ release is available in the update feed." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يتوفر إصدار %@ في موجز التحديث." } } } },
    "No compatible Node.js %@ release was found." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم يتم العثور على إصدار Node.js %@ متوافق." } } } },
    "No local sites were found to start." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم يتم العثور على مواقع محلية لتشغيلها." } } } },
    "PHP %@ is not available for new HerdMe installations. Install PHP 8.0 through 8.5 instead." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "PHP %@ غير متاح لتثبيتات HerdMe الجديدة. ثبّت PHP من 8.0 إلى 8.5 بدلاً منه." } } } },
    "Port %lld is already in use. Choose another port for this service." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المنفذ %lld مستخدم بالفعل. اختر منفذاً آخر لهذه الخدمة." } } } },
    "Site creation was cancelled. The incomplete project was removed." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أُلغي إنشاء الموقع وتمت إزالة المشروع غير المكتمل." } } } },
    "The %1$@ service did not become ready on port %2$lld. Check its log for details." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم تصبح خدمة %1$@ جاهزة على المنفذ %2$lld. راجع سجلها للتفاصيل." } } } },
    "The %@ service exited before it became ready. Check its log for details." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "توقفت خدمة %@ قبل أن تصبح جاهزة. راجع سجلها للتفاصيل." } } } },
    "The HerdMe local certificate authority was not trusted." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم يتم الوثوق بسلطة شهادات HerdMe المحلية." } } } },
    "The Xdebug archive contains an unsafe path and was rejected." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتوي أرشيف Xdebug على مسار غير آمن ولذلك تم رفضه." } } } },
    "The Xdebug release service returned an invalid version." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أعادت خدمة إصدارات Xdebug إصداراً غير صالح." } } } },
    "The built Xdebug extension could not be loaded by the selected PHP runtime." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على بيئة PHP المحددة تحميل إضافة Xdebug المبنية." } } } },
    "The downloaded Xdebug archive did not match its official SHA-256 checksum." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم يطابق أرشيف Xdebug المنزّل بصمة SHA-256 الرسمية." } } } },
    "The downloaded runtime could not be unpacked." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر فك حزمة بيئة التشغيل المنزّلة." } } } },
    "The local domain command completed, but its resolver or helper files could not be verified." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اكتمل أمر النطاق المحلي، لكن تعذر التحقق من ملفات المحلل أو المساعد." } } } },
    "The local domain resolver could not be installed." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر تثبيت محلل النطاقات المحلية." } } } },
    "The local server for %@ could not be started." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر تشغيل الخادم المحلي للموقع %@." } } } },
    "The local site environment did not become healthy in time." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم تصبح بيئة المواقع المحلية سليمة ضمن المهلة." } } } },
    "The remote update feed is not signed and was rejected." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "موجز التحديث البعيد غير موقّع ولذلك تم رفضه." } } } },
    "The resolver for this top-level domain is managed outside HerdMe and was not changed." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تتم إدارة محلل هذا النطاق الأعلى خارج HerdMe ولذلك لم يتم تغييره." } } } },
    "The runtime package manager failed." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فشل مدير حزم بيئة التشغيل." } } } },
    "The runtime server returned an invalid response." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أعاد خادم بيئة التشغيل استجابة غير صالحة." } } } },
    "The service package command failed." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فشل أمر حزمة الخدمة." } } } },
    "The signed update feed must contain HTTPS downloads for macOS and Windows x64." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يجب أن يحتوي موجز التحديث الموقّع على تنزيلات HTTPS لنظامي macOS وWindows x64." } } } },
    "The top-level domain may only contain letters, numbers, and hyphens." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يجب أن يحتوي النطاق الأعلى على أحرف وأرقام وشرطات فقط." } } } },
    "The update feed signature is invalid. The update was rejected." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "توقيع موجز التحديث غير صالح، ولذلك تم رفض التحديث." } } } },
    "The update service returned an invalid response." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أعادت خدمة التحديث استجابة غير صالحة." } } } },
    "This HerdMe build does not contain its local network helper." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا تتضمن نسخة HerdMe هذه مساعد الشبكة المحلية." } } } },
    "This HerdMe build does not contain its signed network service manifest." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا تتضمن نسخة HerdMe هذه بيان خدمة الشبكة الموقّع." } } } },
    "This Mac architecture is not supported by the selected runtime." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "معمارية Mac هذه غير مدعومة من بيئة التشغيل المحددة." } } } },
    "This build does not contain the public key required to verify updates." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا تتضمن هذه النسخة المفتاح العام المطلوب للتحقق من التحديثات." } } } },
    "Xdebug could not be built." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر بناء Xdebug." } } } },
    "Xdebug requires %@. Install the Xcode Command Line Tools and try again." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتطلب Xdebug الأداة %@. ثبّت أدوات سطر أوامر Xcode ثم أعد المحاولة." } } } },
    "HerdMe does not have permission to write the required files. Choose a writable folder and try again." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يملك HerdMe صلاحية كتابة الملفات المطلوبة. اختر مجلداً قابلاً للكتابة ثم أعد المحاولة." } } } },
    "Homebrew blocked the verified runtime formula. HerdMe could not approve it automatically; review Logs/homebrew.log and try again." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حظر Homebrew صيغة بيئة التشغيل التي تم التحقق منها، وتعذر على HerdMe اعتمادها تلقائياً. راجع Logs/homebrew.log ثم أعد المحاولة." } } } },
    "Installer log: %@" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سجل التثبيت: %@" } } } },
    "Laravel could not write to the new project's log files. Check disk space and folder permissions, then try again." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر على Laravel الكتابة في سجلات المشروع الجديد. تحقق من مساحة القرص وصلاحيات المجلد ثم أعد المحاولة." } } } },
    "Project folder: %@" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مجلد المشروع: %@" } } } },
    "The download server could not be reached. Check the network connection and try again." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر الوصول إلى خادم التنزيل. تحقق من اتصال الشبكة ثم أعد المحاولة." } } } },
    "The operation could not be completed." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر إكمال العملية." } } } },
    "The site could not be created." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر إنشاء الموقع." } } } },
    "There is not enough free disk space to finish the operation. Free some space and try again." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد مساحة حرة كافية لإكمال العملية. حرر بعض المساحة ثم أعد المحاولة." } } } },
