    "Create" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إنشاء" } } } },
    "Create databases, queues, search engines, storage, and realtime services for local development." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أنشئ قواعد البيانات والطوابير ومحركات البحث والتخزين وخدمات الوقت الفعلي للتطوير المحلي." } } } },
    "Creating Laravel project" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إنشاء مشروع Laravel" } } } },
